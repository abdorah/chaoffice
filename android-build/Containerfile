# Android cross-compilation container for Sweet Lab Core
# Uses Linux + Android NDK + Rust to build .so files for all Android ABIs

FROM docker.io/library/rust:1.86-bookworm

# Install dependencies for Android NDK and C compilation
RUN apt-get update && apt-get install -y \
    unzip \
    wget \
    protobuf-compiler \
    && rm -rf /var/lib/apt/lists/*

# Install Android NDK (commandlinetools approach)
ENV ANDROID_HOME=/opt/android-sdk
ENV NDK_VERSION=r27c
ENV NDK_HOME=${ANDROID_HOME}/ndk/${NDK_VERSION}

RUN mkdir -p ${ANDROID_HOME} && \
    wget -q https://dl.google.com/android/repository/android-ndk-${NDK_VERSION}-linux.zip -O /tmp/ndk.zip && \
    unzip -q /tmp/ndk.zip -d ${ANDROID_HOME}/ndk/ && \
    mv ${ANDROID_HOME}/ndk/android-ndk-${NDK_VERSION} ${NDK_HOME} && \
    rm /tmp/ndk.zip

# Set up toolchain paths
ENV TOOLCHAIN=${NDK_HOME}/toolchains/llvm/prebuilt/linux-x86_64

# Add Rust Android targets
RUN rustup target add \
    aarch64-linux-android \
    armv7-linux-androideabi \
    x86_64-linux-android

# Configure Cargo to use NDK linkers and CC for each target
RUN mkdir -p /root/.cargo && cat > /root/.cargo/config.toml <<'EOF'
[target.aarch64-linux-android]
ar = "/opt/android-sdk/ndk/r27c/toolchains/llvm/prebuilt/linux-x86_64/bin/llvm-ar"
linker = "/opt/android-sdk/ndk/r27c/toolchains/llvm/prebuilt/linux-x86_64/bin/aarch64-linux-android26-clang"

[target.armv7-linux-androideabi]
ar = "/opt/android-sdk/ndk/r27c/toolchains/llvm/prebuilt/linux-x86_64/bin/llvm-ar"
linker = "/opt/android-sdk/ndk/r27c/toolchains/llvm/prebuilt/linux-x86_64/bin/armv7a-linux-androideabi26-clang"

[target.x86_64-linux-android]
ar = "/opt/android-sdk/ndk/r27c/toolchains/llvm/prebuilt/linux-x86_64/bin/llvm-ar"
linker = "/opt/android-sdk/ndk/r27c/toolchains/llvm/prebuilt/linux-x86_64/bin/x86_64-linux-android26-clang"
EOF

WORKDIR /build
