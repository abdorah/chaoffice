// StockTrackingPage — Stock movement history with chart visualization

import { GroupBox, VerticalBox, HorizontalBox, StandardTableView, Button,
         ComboBox, SpinBox, LineEdit, Palette, StyleMetrics } from "std-widgets.slint";
import { Page } from "../components/page.slint";
import { LineChart } from "../components/line_chart.slint";
import { StatCard } from "../components/stat_card.slint";
import { AppState } from "../globals/app_state.slint";
import { TranslationStrings } from "../globals/translation_strings.slint";

export global StockTrackingAdapter {
    in property <[[StandardListViewItem]]> movement-rows: [];
    // SVG path string computed in Rust from stock history data
    in property <string> stock-trend-path: "";
    in property <string> stock-trend-fill: "";
    in property <[string]> trend-x-labels: [];
    // Product and location lists for form selectors
    in property <[string]> product-names: [];
    in property <[string]> location-names: [];
    // Error message from last record attempt
    in property <string> error-message: "";

    // Callbacks bridged to Rust controller
    callback record-movement(/* product */ string, /* type */ string, /* qty */ int,
                              /* from_loc */ string, /* to_loc */ string, /* note */ string);
    callback load-history(/* product */ string, /* from_date */ string, /* to_date */ string);
    callback load-summary();
}

export component StockTrackingPage inherits Page {
    property <bool> show-form: false;

    title: TranslationStrings.stock-title;
    description: TranslationStrings.stock-description;

    HorizontalBox {
        vertical-stretch: 0;
        spacing: 12px;

        StatCard {
            label: TranslationStrings.stock-total-inbound-30d;
            value: AppState.stock-inbound-30d;
            accent-color: #4CAF50;
        }

        StatCard {
            label: TranslationStrings.stock-total-outbound-30d;
            value: AppState.stock-outbound-30d;
            accent-color: #FF9800;
        }

        StatCard {
            label: TranslationStrings.stock-net-change-30d;
            value: AppState.stock-net-30d;
            accent-color: #2196F3;
        }
    }

    LineChart {
        vertical-stretch: 0;
        min-height: 180px;
        title: TranslationStrings.stock-stock-level-trend;
        svg-path: StockTrackingAdapter.stock-trend-path;
        fill-path: StockTrackingAdapter.stock-trend-fill;
        x-labels: StockTrackingAdapter.trend-x-labels;
        line-color: #2196F3;
    }

    HorizontalBox {
        vertical-stretch: 0;

        Button {
            text: TranslationStrings.stock-record-movement;
            primary: true;
            clicked => { root.show-form = !root.show-form; }
        }
    }

    // Error message display
    if StockTrackingAdapter.error-message != "" : Rectangle {
        vertical-stretch: 0;
        background: #FFEBEE;
        border-radius: 4px;
        min-height: 32px;

        HorizontalBox {
            padding: 8px;
            Text {
                text: StockTrackingAdapter.error-message;
                color: #C62828;
                font-size: 13px;
                wrap: word-wrap;
            }
        }
    }

    if root.show-form : GroupBox {
        vertical-stretch: 0;
        title: TranslationStrings.stock-new-movement;

        VerticalBox {
            HorizontalBox {
                spacing: 8px;

                VerticalBox {
                    horizontal-stretch: 1;
                    Text { text: TranslationStrings.stock-product; }
                    product-input := ComboBox {
                        horizontal-stretch: 1;
                        model: StockTrackingAdapter.product-names;
                    }
                }

                VerticalBox {
                    horizontal-stretch: 1;
                    Text { text: TranslationStrings.stock-type; }
                    type-input := ComboBox {
                        horizontal-stretch: 1;
                        model: ["Inbound", "Outbound", "Transfer", "Adjustment", "Return"];
                    }
                }

                VerticalBox {
                    horizontal-stretch: 1;
                    Text { text: TranslationStrings.stock-quantity; }
                    qty-input := SpinBox { horizontal-stretch: 1; value: 1; minimum: 1; maximum: 999999; }
                }
            }

            HorizontalBox {
                spacing: 8px;

                VerticalBox {
                    horizontal-stretch: 1;
                    Text { text: TranslationStrings.stock-from-location; }
                    from-loc-input := ComboBox {
                        horizontal-stretch: 1;
                        model: StockTrackingAdapter.location-names;
                    }
                }

                VerticalBox {
                    horizontal-stretch: 1;
                    Text { text: TranslationStrings.stock-to-location; }
                    to-loc-input := ComboBox {
                        horizontal-stretch: 1;
                        model: StockTrackingAdapter.location-names;
                    }
                }
            }

            HorizontalBox {
                spacing: 8px;

                VerticalBox {
                    horizontal-stretch: 1;
                    Text { text: TranslationStrings.stock-note; }
                    note-input := LineEdit { horizontal-stretch: 1; placeholder-text: TranslationStrings.stock-note-placeholder; }
                }
            }

            HorizontalBox {
                alignment: end;
                spacing: 8px;

                Button {
                    text: TranslationStrings.common-cancel;
                    clicked => { root.show-form = false; }
                }

                Button {
                    text: TranslationStrings.common-record;
                    primary: true;
                    clicked => {
                        StockTrackingAdapter.record-movement(
                            product-input.current-value,
                            type-input.current-value,
                            qty-input.value,
                            from-loc-input.current-value,
                            to-loc-input.current-value,
                            note-input.text
                        );
                        // Don't close form — keep it open so errors are visible (Req 5.4)
                    }
                }
            }
        }
    }

    GroupBox {
        title: TranslationStrings.stock-movement-history;
        vertical-stretch: 1;

        StandardTableView {
            columns: [
                { title: TranslationStrings.stock-col-date },
                { title: TranslationStrings.stock-col-type },
                { title: TranslationStrings.stock-col-product },
                { title: TranslationStrings.stock-col-qty },
                { title: TranslationStrings.stock-col-from },
                { title: TranslationStrings.stock-col-to },
                { title: TranslationStrings.stock-col-user },
                { title: TranslationStrings.stock-col-note },
            ];
            rows: StockTrackingAdapter.movement-rows;
        }
    }
}
