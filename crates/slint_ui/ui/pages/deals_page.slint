// DealsPage — Deal management with frequency and status tracking

import { GroupBox, VerticalBox, HorizontalBox, StandardTableView, Button,
         LineEdit, ComboBox, Palette, StyleMetrics, DatePickerPopup } from "std-widgets.slint";
import { Page } from "../components/page.slint";
import { SearchBar } from "../components/search_bar.slint";
import { AppState, DealItem } from "../globals/app_state.slint";

export global DealsPageAdapter {
    in property <[[StandardListViewItem]]> row-data: [];
    in property <[string]> supplier-names: [];
    in property <[string]> product-names: [];
    in property <[string]> manager-names: [];
    in-out property <string> selected-supplier: "";
    in-out property <string> selected-product: "";
    in-out property <string> selected-manager: "";
    // Edit mode support
    in-out property <int> editing-id: 0;
    in-out property <string> edit-title: "";
    in-out property <string> edit-description: "";
    in-out property <string> edit-frequency: "OneTime";
    in-out property <string> edit-status: "Draft";
    // Deal IDs parallel to row-data for row selection
    in property <[int]> deal-ids: [];
}

export component DealsPage inherits Page {
    property <int> sort-index: -1;
    property <bool> sort-ascending;
    property <bool> show-form: false;
    property <string> start-date-text: "Select start date";
    property <string> end-date-text: "Select end date";

    title: "Deals";
    description: "Track supplier deals, recurring orders, and contract status.";

    SearchBar {
        vertical-stretch: 0;
        placeholder: "Search deals...";
        action-text: "New Deal";
        action-clicked => {
            // Reset edit mode when opening form for new deal
            DealsPageAdapter.editing-id = 0;
            DealsPageAdapter.edit-title = "";
            DealsPageAdapter.edit-description = "";
            DealsPageAdapter.edit-frequency = "OneTime";
            DealsPageAdapter.edit-status = "Draft";
            root.show-form = !root.show-form;
        }
    }

    if root.show-form : GroupBox {
        vertical-stretch: 0;
        title: DealsPageAdapter.editing-id > 0 ? "Edit Deal" : "New Deal";

        VerticalBox {
            HorizontalBox {
                spacing: 8px;

                VerticalBox {
                    horizontal-stretch: 1;
                    Text { text: "Title"; }
                    title-input := LineEdit {
                        horizontal-stretch: 1;
                        placeholder-text: "Deal title";
                        text <=> DealsPageAdapter.edit-title;
                    }
                }

                VerticalBox {
                    horizontal-stretch: 1;
                    Text { text: "Description"; }
                    desc-input := LineEdit {
                        horizontal-stretch: 1;
                        placeholder-text: "Description";
                        text <=> DealsPageAdapter.edit-description;
                    }
                }
            }

            HorizontalBox {
                spacing: 8px;

                VerticalBox {
                    horizontal-stretch: 1;
                    Text { text: "Frequency"; }
                    freq-input := ComboBox {
                        horizontal-stretch: 1;
                        model: ["OneTime", "Weekly", "Monthly", "Quarterly", "Yearly"];
                        current-value <=> DealsPageAdapter.edit-frequency;
                    }
                }

                VerticalBox {
                    horizontal-stretch: 1;
                    Text { text: "Status"; }
                    status-input := ComboBox {
                        horizontal-stretch: 1;
                        model: ["Draft", "Active", "Completed", "Cancelled"];
                        current-value <=> DealsPageAdapter.edit-status;
                    }
                }

                VerticalBox {
                    horizontal-stretch: 1;
                    Text { text: "Start Date"; }
                    Button {
                        horizontal-stretch: 1;
                        text: root.start-date-text;
                        clicked => { start-date-picker.show(); }
                    }
                }

                VerticalBox {
                    horizontal-stretch: 1;
                    Text { text: "End Date"; }
                    Button {
                        horizontal-stretch: 1;
                        text: root.end-date-text;
                        clicked => { end-date-picker.show(); }
                    }
                }
            }

            HorizontalBox {
                spacing: 8px;

                VerticalBox {
                    horizontal-stretch: 1;
                    Text { text: "Supplier"; }
                    supplier-input := ComboBox {
                        horizontal-stretch: 1;
                        model: DealsPageAdapter.supplier-names;
                        current-value <=> DealsPageAdapter.selected-supplier;
                    }
                }

                VerticalBox {
                    horizontal-stretch: 1;
                    Text { text: "Product"; }
                    product-input := ComboBox {
                        horizontal-stretch: 1;
                        model: DealsPageAdapter.product-names;
                        current-value <=> DealsPageAdapter.selected-product;
                    }
                }

                VerticalBox {
                    horizontal-stretch: 1;
                    Text { text: "Manager"; }
                    manager-input := ComboBox {
                        horizontal-stretch: 1;
                        model: DealsPageAdapter.manager-names;
                        current-value <=> DealsPageAdapter.selected-manager;
                    }
                }
            }

            HorizontalBox {
                alignment: end;
                spacing: 8px;

                Button {
                    text: "Cancel";
                    clicked => {
                        DealsPageAdapter.editing-id = 0;
                        root.show-form = false;
                    }
                }

                Button {
                    text: DealsPageAdapter.editing-id > 0 ? "Save" : "Create";
                    primary: true;
                    clicked => {
                        if DealsPageAdapter.editing-id > 0 {
                            AppState.update-deal(
                                DealsPageAdapter.editing-id,
                                DealsPageAdapter.edit-title,
                                DealsPageAdapter.edit-description,
                                DealsPageAdapter.edit-frequency,
                                DealsPageAdapter.edit-status,
                            );
                        } else {
                            AppState.create-deal(
                                title-input.text,
                                desc-input.text,
                                0, 0, 0,
                                freq-input.current-value
                            );
                        }
                        DealsPageAdapter.editing-id = 0;
                        root.show-form = false;
                    }
                }
            }
        }
    }

    GroupBox {
        title: "Deals";
        vertical-stretch: 1;

        VerticalBox {
            deals-table := StandardTableView {
                sort-ascending(index) => {
                    root.sort-index = index;
                    root.sort-ascending = true;
                }
                sort-descending(index) => {
                    root.sort-index = index;
                    root.sort-ascending = false;
                }

                columns: [
                    { title: "Title" },
                    { title: "Product" },
                    { title: "Supplier" },
                    { title: "Manager" },
                    { title: "Frequency" },
                    { title: "Status" },
                ];

                rows: DealsPageAdapter.row-data;
            }

            HorizontalBox {
                vertical-stretch: 0;
                alignment: start;
                spacing: 8px;

                Button {
                    text: "Edit Selected";
                    enabled: deals-table.current-row >= 0 && deals-table.current-row < DealsPageAdapter.row-data.length;
                    clicked => {
                        if deals-table.current-row >= 0 && deals-table.current-row < DealsPageAdapter.row-data.length {
                            DealsPageAdapter.editing-id = DealsPageAdapter.deal-ids[deals-table.current-row];
                            DealsPageAdapter.edit-title = DealsPageAdapter.row-data[deals-table.current-row][0].text;
                            DealsPageAdapter.edit-description = "";
                            DealsPageAdapter.edit-frequency = DealsPageAdapter.row-data[deals-table.current-row][4].text;
                            DealsPageAdapter.edit-status = DealsPageAdapter.row-data[deals-table.current-row][5].text;
                            root.show-form = true;
                        }
                    }
                }
            }
        }
    }

    start-date-picker := DatePickerPopup {
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        accepted(date) => {
            root.start-date-text = date.year + "-" + date.month + "-" + date.day;
        }
    }

    end-date-picker := DatePickerPopup {
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        accepted(date) => {
            root.end-date-text = date.year + "-" + date.month + "-" + date.day;
        }
    }
}
