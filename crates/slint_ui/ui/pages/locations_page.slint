// LocationsPage — Warehouse/location management with capacity tracking

import { GroupBox, VerticalBox, HorizontalBox, StandardTableView, Button,
         LineEdit, SpinBox, ComboBox, Palette, StyleMetrics, ProgressIndicator } from "std-widgets.slint";
import { Page } from "../components/page.slint";
import { SearchBar } from "../components/search_bar.slint";
import { AppState, LocationItem } from "../globals/app_state.slint";
import { TranslationStrings } from "../globals/translation_strings.slint";

export global LocationsPageAdapter {
    in property <[[StandardListViewItem]]> row-data: [];
    in-out property <int> editing-id: 0;
    in-out property <string> edit-name: "";
    in-out property <string> edit-address: "";
    in-out property <int> edit-capacity: 100;
    in-out property <string> selected-manager: "";
    in property <[string]> manager-names: [];
    in property <[int]> location-ids: [];
}

export component LocationsPage inherits Page {
    property <int> sort-index: -1;
    property <bool> sort-ascending;
    property <bool> show-form: false;

    title: TranslationStrings.locations-title;
    description: TranslationStrings.locations-description;

    SearchBar {
        vertical-stretch: 0;
        placeholder: TranslationStrings.locations-search-placeholder;
        action-text: TranslationStrings.locations-add-location;
        action-clicked => {
            // Reset edit mode when opening form for new location
            LocationsPageAdapter.editing-id = 0;
            LocationsPageAdapter.edit-name = "";
            LocationsPageAdapter.edit-address = "";
            LocationsPageAdapter.edit-capacity = 100;
            LocationsPageAdapter.selected-manager = "";
            root.show-form = !root.show-form;
        }
    }

    if root.show-form : GroupBox {
        vertical-stretch: 0;
        title: LocationsPageAdapter.editing-id > 0 ? TranslationStrings.locations-edit-location : TranslationStrings.locations-new-location;

        VerticalBox {
            HorizontalBox {
                spacing: 8px;

                VerticalBox {
                    horizontal-stretch: 1;
                    Text { text: TranslationStrings.locations-name; }
                    name-input := LineEdit {
                        horizontal-stretch: 1;
                        placeholder-text: TranslationStrings.locations-name-placeholder;
                        text <=> LocationsPageAdapter.edit-name;
                    }
                }

                VerticalBox {
                    horizontal-stretch: 1;
                    Text { text: TranslationStrings.locations-address; }
                    addr-input := LineEdit {
                        horizontal-stretch: 1;
                        placeholder-text: TranslationStrings.locations-address-placeholder;
                        text <=> LocationsPageAdapter.edit-address;
                    }
                }
            }

            HorizontalBox {
                spacing: 8px;

                VerticalBox {
                    horizontal-stretch: 1;
                    Text { text: TranslationStrings.locations-latitude; }
                    lat-input := LineEdit { horizontal-stretch: 1; placeholder-text: TranslationStrings.locations-lat-placeholder; }
                }

                VerticalBox {
                    horizontal-stretch: 1;
                    Text { text: TranslationStrings.locations-longitude; }
                    lng-input := LineEdit { horizontal-stretch: 1; placeholder-text: TranslationStrings.locations-lng-placeholder; }
                }

                VerticalBox {
                    horizontal-stretch: 1;
                    Text { text: TranslationStrings.locations-capacity; }
                    cap-input := SpinBox {
                        horizontal-stretch: 1;
                        value <=> LocationsPageAdapter.edit-capacity;
                        minimum: 1;
                        maximum: 999999;
                    }
                }

                VerticalBox {
                    horizontal-stretch: 1;
                    Text { text: TranslationStrings.locations-manager; }
                    manager-input := ComboBox {
                        horizontal-stretch: 1;
                        model: LocationsPageAdapter.manager-names;
                        current-value <=> LocationsPageAdapter.selected-manager;
                    }
                }
            }

            HorizontalBox {
                alignment: end;
                spacing: 8px;

                Button {
                    text: TranslationStrings.common-cancel;
                    clicked => {
                        LocationsPageAdapter.editing-id = 0;
                        root.show-form = false;
                    }
                }

                Button {
                    text: LocationsPageAdapter.editing-id > 0 ? TranslationStrings.common-save : TranslationStrings.common-create;
                    primary: true;
                    clicked => {
                        if LocationsPageAdapter.editing-id > 0 {
                            AppState.update-location(
                                LocationsPageAdapter.editing-id,
                                LocationsPageAdapter.edit-name,
                                LocationsPageAdapter.edit-address,
                                LocationsPageAdapter.edit-capacity,
                            );
                        } else {
                            AppState.create-location(
                                name-input.text,
                                addr-input.text,
                                0.0, 0.0,
                                cap-input.value
                            );
                        }
                        LocationsPageAdapter.editing-id = 0;
                        root.show-form = false;
                    }
                }
            }
        }
    }

    GroupBox {
        title: TranslationStrings.locations-group-title;
        vertical-stretch: 1;

        VerticalBox {
            locations-table := StandardTableView {
                sort-ascending(index) => {
                    root.sort-index = index;
                    root.sort-ascending = true;
                }
                sort-descending(index) => {
                    root.sort-index = index;
                    root.sort-ascending = false;
                }

                columns: [
                    { title: TranslationStrings.locations-col-name },
                    { title: TranslationStrings.locations-col-address },
                    { title: TranslationStrings.locations-col-manager },
                    { title: TranslationStrings.locations-col-capacity },
                    { title: TranslationStrings.locations-col-used },
                    { title: TranslationStrings.locations-col-lat },
                    { title: TranslationStrings.locations-col-lng },
                ];

                rows: LocationsPageAdapter.row-data;
            }

            HorizontalBox {
                vertical-stretch: 0;
                alignment: start;
                spacing: 8px;

                Button {
                    text: TranslationStrings.common-edit-selected;
                    enabled: locations-table.current-row >= 0 && locations-table.current-row < LocationsPageAdapter.row-data.length;
                    clicked => {
                        if locations-table.current-row >= 0 && locations-table.current-row < LocationsPageAdapter.row-data.length {
                            LocationsPageAdapter.editing-id = LocationsPageAdapter.location-ids[locations-table.current-row];
                            LocationsPageAdapter.edit-name = LocationsPageAdapter.row-data[locations-table.current-row][0].text;
                            LocationsPageAdapter.edit-address = LocationsPageAdapter.row-data[locations-table.current-row][1].text;
                            LocationsPageAdapter.selected-manager = LocationsPageAdapter.row-data[locations-table.current-row][2].text;
                            LocationsPageAdapter.edit-capacity = 0;
                            root.show-form = true;
                        }
                    }
                }
            }
        }
    }
}
