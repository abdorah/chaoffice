// LoginPage — Authentication screen shown before main app

import { VerticalBox, HorizontalBox, LineEdit, Button, Palette } from "std-widgets.slint";
import { AppState } from "../globals/app_state.slint";
import { AppSettings } from "../globals/app_settings.slint";
import { TranslationStrings } from "../globals/translation_strings.slint";

export component LoginPage inherits Rectangle {
    background: Palette.background;

    callback login(string, string);

    // Apply dark mode on the login screen too
    Timer {
        interval: 200ms;
        running: AppSettings.dark-mode && Palette.color-scheme != ColorScheme.dark;
        triggered => {
            Palette.color-scheme = ColorScheme.dark;
        }
    }

    Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 360px;
        height: form.preferred-height + 64px;
        border-radius: 12px;
        background: Palette.background.darker(0.05);

        form := VerticalBox {
            padding: 24px;
            spacing: 16px;

            Text {
                text: TranslationStrings.login-title;
                font-size: 22px;
                horizontal-alignment: center;
            }

            Text {
                text: TranslationStrings.login-subtitle;
                font-size: 12px;
                horizontal-alignment: center;
                color: Palette.foreground.transparentize(0.4);
            }

            VerticalBox {
                spacing: 8px;

                Text { text: TranslationStrings.login-username; }
                username-input := LineEdit {
                    placeholder-text: TranslationStrings.login-username-placeholder;
                }
            }

            VerticalBox {
                spacing: 8px;

                Text { text: TranslationStrings.login-password; }
                password-input := LineEdit {
                    placeholder-text: TranslationStrings.login-password-placeholder;
                    input-type: InputType.password;
                }
            }

            if AppState.login-error != "" : Text {
                text: AppState.login-error;
                color: #F44336;
                font-size: 12px;
                horizontal-alignment: center;
            }

            Button {
                text: TranslationStrings.login-sign-in;
                primary: true;
                clicked => {
                    root.login(username-input.text, password-input.text);
                }
            }
        }
    }
}
