// SyncPage — TursoDB/LibSQL sync management (online/offline)

import { GroupBox, VerticalBox, HorizontalBox, Button, ProgressIndicator, Palette,
         LineEdit, Switch, SpinBox } from "std-widgets.slint";
import { Page } from "../components/page.slint";
import { StatCard } from "../components/stat_card.slint";
import { AppState } from "../globals/app_state.slint";
import { TranslationStrings } from "../globals/translation_strings.slint";

// Persistent adapter — survives page destruction/recreation on navigation
export global SyncPageAdapter {
    in-out property <string> turso-url: "";
    in-out property <string> turso-token: "";
    in-out property <bool> auto-sync-enabled: false;
    in-out property <int> sync-interval: 60;
}

export component SyncPage inherits Page {
    title: TranslationStrings.sync-title;
    description: TranslationStrings.sync-description;

    HorizontalBox {
        vertical-stretch: 0;
        spacing: 12px;

        StatCard {
            label: TranslationStrings.sync-pending-changes;
            value: AppState.sync-status.pending-changes;
            accent-color: AppState.sync-status.pending-changes > 0 ? #FF9800 : #4CAF50;
        }

        StatCard {
            label: TranslationStrings.sync-connection;
            value: AppState.sync-status.is-online ? TranslationStrings.sync-online : TranslationStrings.sync-local;
            accent-color: AppState.sync-status.is-online ? #4CAF50 : #2196F3;
        }
    }

    GroupBox {
        title: TranslationStrings.sync-sync-actions;
        vertical-stretch: 0;

        VerticalBox {
            spacing: 12px;

            HorizontalBox {
                Text { text: TranslationStrings.sync-last-synchronized; }
                Text {
                    text: AppState.sync-status.last-sync-at;
                    color: Palette.foreground.transparentize(0.3);
                }
            }

            HorizontalBox {
                Text { text: TranslationStrings.sync-status; }
                Text {
                    text: AppState.sync-status.sync-message;
                    color: AppState.sync-status.is-online ? #4CAF50 : Palette.foreground.transparentize(0.3);
                }
            }

            if AppState.syncing : ProgressIndicator {
                indeterminate: true;
            }

            HorizontalBox {
                spacing: 8px;

                Button {
                    text: TranslationStrings.sync-push-to-remote;
                    primary: true;
                    enabled: !AppState.syncing && AppState.sync-status.has-remote-url;
                    clicked => {
                        AppState.sync-to-remote();
                    }
                }

                Button {
                    text: TranslationStrings.sync-pull-from-remote;
                    enabled: !AppState.syncing && AppState.sync-status.has-remote-url;
                    clicked => {
                        AppState.sync-from-remote();
                    }
                }
            }
        }
    }

    GroupBox {
        title: TranslationStrings.sync-database-settings;
        vertical-stretch: 0;

        VerticalBox {
            spacing: 8px;

            HorizontalBox {
                spacing: 8px;
                vertical-stretch: 0;

                VerticalBox {
                    horizontal-stretch: 1;
                    Text { text: TranslationStrings.sync-turso-url; }
                    turso-url := LineEdit {
                        horizontal-stretch: 1;
                        text <=> SyncPageAdapter.turso-url;
                        placeholder-text: TranslationStrings.sync-turso-url-placeholder;
                    }
                }
            }

            HorizontalBox {
                spacing: 8px;
                vertical-stretch: 0;

                VerticalBox {
                    horizontal-stretch: 1;
                    Text { text: TranslationStrings.sync-auth-token; }
                    turso-token := LineEdit {
                        horizontal-stretch: 1;
                        text <=> SyncPageAdapter.turso-token;
                        placeholder-text: TranslationStrings.sync-auth-token-placeholder;
                        input-type: password;
                    }
                }
            }

            HorizontalBox {
                spacing: 16px;
                vertical-stretch: 0;

                auto-sync-switch := Switch {
                    text: TranslationStrings.sync-auto-sync-enabled;
                    checked <=> SyncPageAdapter.auto-sync-enabled;
                }

                VerticalBox {
                    horizontal-stretch: 0;
                    Text { text: TranslationStrings.sync-interval-seconds; }
                    sync-interval := SpinBox {
                        horizontal-stretch: 0;
                        value <=> SyncPageAdapter.sync-interval;
                        minimum: 10;
                        maximum: 3600;
                    }
                }

                Rectangle { horizontal-stretch: 1; }
            }

            HorizontalBox {
                alignment: end;
                spacing: 8px;

                Button {
                    text: TranslationStrings.sync-test-connection;
                    enabled: !AppState.syncing && SyncPageAdapter.turso-url != "";
                    clicked => {
                        AppState.test-connection();
                    }
                }

                Button {
                    text: TranslationStrings.sync-save-settings;
                    primary: true;
                    clicked => {
                        AppState.configure-sync(
                            SyncPageAdapter.turso-url,
                            SyncPageAdapter.turso-token,
                            SyncPageAdapter.auto-sync-enabled,
                            SyncPageAdapter.sync-interval
                        );
                    }
                }
            }
        }
    }

    GroupBox {
        title: TranslationStrings.sync-offline-mode;
        vertical-stretch: 1;

        VerticalBox {
            Text {
                text: TranslationStrings.sync-offline-description;
                wrap: word-wrap;
                color: Palette.foreground.transparentize(0.3);
            }
        }
    }
}
