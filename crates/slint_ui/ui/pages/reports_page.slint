// ReportsPage — Generate inventory, stock, budget, and purchasing reports

import { GroupBox, VerticalBox, HorizontalBox, Button, ComboBox,
         CheckBox, ProgressIndicator, LineEdit, Palette } from "std-widgets.slint";
import { Page } from "../components/page.slint";
import { AppState } from "../globals/app_state.slint";
import { TranslationStrings } from "../globals/translation_strings.slint";

export component ReportsPage inherits Page {
    title: TranslationStrings.reports-title;
    description: TranslationStrings.reports-description;

    GroupBox {
        vertical-stretch: 0;
        title: TranslationStrings.reports-inventory-report;

        VerticalBox {
            padding: 8px;

            HorizontalBox {
                spacing: 12px;

                VerticalBox {
                    horizontal-stretch: 1;
                    Text { text: TranslationStrings.common-format; }
                    inv-format := ComboBox {
                        model: ["Excel", "PDF", "CSV"];
                    }
                }

                inv-zero := CheckBox {
                    text: TranslationStrings.reports-include-zero-stock;
                }

                Button {
                    text: TranslationStrings.common-generate;
                    min-width: 100px;
                    primary: true;
                    enabled: !AppState.report-generating;
                    clicked => {
                        AppState.report-generating = true;
                        AppState.report-output = "";
                        AppState.generate-inventory-report(inv-format.current-value, inv-zero.checked);
                    }
                }
            }
        }
    }

    GroupBox {
        vertical-stretch: 0;
        title: TranslationStrings.reports-stock-movement-report;

        VerticalBox {
            padding: 8px;

            HorizontalBox {
                spacing: 12px;

                VerticalBox {
                    horizontal-stretch: 1;
                    Text { text: TranslationStrings.common-format; }
                    stock-format := ComboBox {
                        model: ["Excel", "PDF", "CSV"];
                    }
                }

                Button {
                    text: TranslationStrings.common-generate;
                    min-width: 100px;
                    primary: true;
                    enabled: !AppState.report-generating;
                    clicked => {
                        AppState.report-generating = true;
                        AppState.report-output = "";
                        AppState.generate-stock-report(stock-format.current-value);
                    }
                }
            }
        }
    }

    GroupBox {
        vertical-stretch: 0;
        title: TranslationStrings.reports-budget-report;

        VerticalBox {
            padding: 8px;

            HorizontalBox {
                spacing: 12px;

                VerticalBox {
                    horizontal-stretch: 1;
                    Text { text: TranslationStrings.common-format; }
                    budget-format := ComboBox {
                        model: ["Excel", "PDF", "CSV"];
                    }
                }

                budget-proj := CheckBox {
                    text: TranslationStrings.reports-include-projections;
                }

                Button {
                    text: TranslationStrings.common-generate;
                    min-width: 100px;
                    primary: true;
                    enabled: !AppState.report-generating;
                    clicked => {
                        AppState.report-generating = true;
                        AppState.report-output = "";
                        AppState.generate-budget-report(budget-format.current-value, budget-proj.checked);
                    }
                }
            }
        }
    }

    GroupBox {
        vertical-stretch: 0;
        title: TranslationStrings.reports-purchasing-report;

        VerticalBox {
            padding: 8px;

            HorizontalBox {
                spacing: 12px;

                VerticalBox {
                    horizontal-stretch: 1;
                    Text { text: TranslationStrings.common-format; }
                    deal-format := ComboBox {
                        model: ["Excel", "PDF", "CSV"];
                    }
                }

                VerticalBox {
                    horizontal-stretch: 1;
                    Text { text: TranslationStrings.reports-status; }
                    deal-status := ComboBox {
                        model: [TranslationStrings.reports-status-all, TranslationStrings.reports-status-active-only, TranslationStrings.reports-status-completed-only];
                    }
                }

                Button {
                    text: TranslationStrings.common-generate;
                    min-width: 100px;
                    primary: true;
                    enabled: !AppState.report-generating;
                    clicked => {
                        AppState.report-generating = true;
                        AppState.report-output = "";
                        AppState.generate-purchasing-report(deal-format.current-value, deal-status.current-value);
                    }
                }
            }
        }
    }

    if AppState.report-generating : ProgressIndicator {
        vertical-stretch: 0;
        indeterminate: true;
    }

    if AppState.report-output != "" : GroupBox {
        vertical-stretch: 0;
        title: TranslationStrings.reports-output;

        Text {
            text: AppState.report-output;
            wrap: word-wrap;
        }
    }

    Rectangle {
        vertical-stretch: 1;
    }
}
