// BudgetPage — Financial tracking with charts and projections

import { GroupBox, VerticalBox, HorizontalBox, StandardTableView, Button,
         ComboBox, LineEdit, Slider, Palette, StyleMetrics, TabWidget, ScrollView,
         DatePickerPopup } from "std-widgets.slint";
import { Page } from "../components/page.slint";
import { LineChart } from "../components/line_chart.slint";
import { BarChart, BarData } from "../components/bar_chart.slint";
import { StatCard } from "../components/stat_card.slint";
import { AppState } from "../globals/app_state.slint";
import { TranslationStrings } from "../globals/translation_strings.slint";

export global BudgetPageAdapter {
    // Monthly breakdown bar chart data
    in property <[BarData]> monthly-bars: [];
    in property <float> monthly-max: 100;

    // Projection line chart SVG paths (computed in Rust)
    in property <string> income-path: "";
    in property <string> expense-path: "";
    in property <string> balance-path: "";
    in property <[string]> projection-x-labels: [];

    // Trend line chart (income vs expenses over historical data)
    in property <string> trend-income-path: "";
    in property <string> trend-expense-path: "";
    in property <[string]> trend-x-labels: [];

    // Table data
    in property <[[StandardListViewItem]]> entry-rows: [];

    // Date range filter
    in-out property <string> from-date: "";
    in-out property <string> to-date: "";

    // Projection months ahead
    in property <int> months-ahead: 6;

    // Error message
    in property <string> error-message: "";

    // Whether the current user can add entries (Admin/Manager only)
    in property <bool> can-add-entry: false;

    // Callbacks bridged to Rust controller
    callback load-summary(/* from_date */ string, /* to_date */ string);
    callback load-projection(/* months_ahead */ int);
    callback record-entry(/* type */ string, /* amount */ string, /* description */ string,
                          /* entry_date */ string, /* product */ string, /* deal */ string);
}

export component BudgetPage inherits Page {
    property <bool> show-form: false;
    property <string> from-date-text: TranslationStrings.budget-select-start-date;
    property <string> to-date-text: TranslationStrings.budget-select-end-date;
    property <string> entry-date-text: TranslationStrings.budget-date;

    title: TranslationStrings.budget-title;
    description: TranslationStrings.budget-description;

    // KPI stat cards
    HorizontalBox {
        vertical-stretch: 0;
        horizontal-stretch: 1;
        spacing: 12px;

        StatCard {
            horizontal-stretch: 1;
            label: TranslationStrings.budget-total-purchases;
            value: AppState.total-purchases;
            accent-color: #F44336;
        }

        StatCard {
            horizontal-stretch: 1;
            label: TranslationStrings.budget-total-sales;
            value: AppState.total-sales;
            accent-color: #4CAF50;
        }

        StatCard {
            horizontal-stretch: 1;
            label: TranslationStrings.budget-total-expenses;
            value: AppState.total-expenses;
            accent-color: #FF9800;
        }

        StatCard {
            horizontal-stretch: 1;
            label: TranslationStrings.budget-net-balance;
            value: AppState.net-balance;
            accent-color: #2196F3;
        }
    }

    // Date range filter
    HorizontalBox {
        vertical-stretch: 0;
        spacing: 8px;

        Text { text: TranslationStrings.common-from; vertical-alignment: center; }
        Button {
            horizontal-stretch: 1;
            text: root.from-date-text;
            clicked => { from-date-picker.show(); }
        }
        Text { text: TranslationStrings.common-to; vertical-alignment: center; }
        Button {
            horizontal-stretch: 1;
            text: root.to-date-text;
            clicked => { to-date-picker.show(); }
        }
        Button {
            text: TranslationStrings.common-apply;
            min-width: 80px;
            clicked => {
                BudgetPageAdapter.load-summary(BudgetPageAdapter.from-date, BudgetPageAdapter.to-date);
            }
        }
    }

    TabWidget {
        vertical-stretch: 1;

        Tab {
            title: TranslationStrings.budget-tab-overview;

            VerticalBox {
                vertical-stretch: 1;
                horizontal-stretch: 1;

                BarChart {
                    vertical-stretch: 0;
                    horizontal-stretch: 1;
                    min-height: 180px;
                    title: TranslationStrings.budget-monthly-breakdown;
                    bars: BudgetPageAdapter.monthly-bars;
                    max-value: BudgetPageAdapter.monthly-max;
                }

                GroupBox {
                    title: TranslationStrings.budget-budget-entries;
                    vertical-stretch: 1;
                    horizontal-stretch: 1;

                    StandardTableView {
                        columns: [
                            { title: TranslationStrings.budget-col-date },
                            { title: TranslationStrings.budget-col-type },
                            { title: TranslationStrings.budget-col-amount },
                            { title: TranslationStrings.budget-col-description },
                            { title: TranslationStrings.budget-col-product },
                            { title: TranslationStrings.budget-col-deal },
                            { title: TranslationStrings.budget-col-recorded-by },
                        ];
                        rows: BudgetPageAdapter.entry-rows;
                    }
                }
            }
        }

        Tab {
            title: TranslationStrings.budget-tab-projection;

            VerticalBox {
                vertical-stretch: 1;
                horizontal-stretch: 1;

                HorizontalBox {
                    vertical-stretch: 0;
                    horizontal-stretch: 1;
                    spacing: 12px;
                    padding-left: 8px;
                    padding-right: 8px;

                    Text { text: TranslationStrings.budget-months-ahead; vertical-alignment: center; }
                    months-slider := Slider {
                        horizontal-stretch: 1;
                        min-width: 200px;
                        minimum: 3;
                        maximum: 12;
                        value: BudgetPageAdapter.months-ahead;
                        changed(val) => {
                            BudgetPageAdapter.load-projection(Math.round(val));
                        }
                    }
                    Text {
                        text: Math.round(months-slider.value);
                        vertical-alignment: center;
                        min-width: 30px;
                    }
                }

                LineChart {
                    vertical-stretch: 1;
                    min-height: 120px;
                    title: TranslationStrings.budget-projected-income;
                    svg-path: BudgetPageAdapter.income-path;
                    x-labels: BudgetPageAdapter.projection-x-labels;
                    line-color: #4CAF50;
                }

                LineChart {
                    vertical-stretch: 1;
                    min-height: 120px;
                    title: TranslationStrings.budget-projected-expenses;
                    svg-path: BudgetPageAdapter.expense-path;
                    x-labels: BudgetPageAdapter.projection-x-labels;
                    line-color: #F44336;
                }

                LineChart {
                    vertical-stretch: 1;
                    min-height: 120px;
                    title: TranslationStrings.budget-projected-balance;
                    svg-path: BudgetPageAdapter.balance-path;
                    x-labels: BudgetPageAdapter.projection-x-labels;
                    line-color: #2196F3;
                }
            }
        }

        Tab {
            title: TranslationStrings.budget-tab-trends;

            VerticalBox {
                vertical-stretch: 1;
                horizontal-stretch: 1;

                LineChart {
                    vertical-stretch: 1;
                    title: TranslationStrings.budget-income-trend;
                    svg-path: BudgetPageAdapter.trend-income-path;
                    x-labels: BudgetPageAdapter.trend-x-labels;
                    line-color: #4CAF50;
                }

                LineChart {
                    vertical-stretch: 1;
                    title: TranslationStrings.budget-expense-trend;
                    svg-path: BudgetPageAdapter.trend-expense-path;
                    x-labels: BudgetPageAdapter.trend-x-labels;
                    line-color: #F44336;
                }
            }
        }
    }

    // Error message display
    if BudgetPageAdapter.error-message != "" : Rectangle {
        vertical-stretch: 0;
        background: #FFEBEE;
        border-radius: 4px;
        min-height: 32px;

        HorizontalBox {
            padding: 8px;
            Text {
                text: BudgetPageAdapter.error-message;
                color: #C62828;
                font-size: 13px;
                wrap: word-wrap;
            }
        }
    }

    // Add entry button — visible only for Admin/Manager
    if BudgetPageAdapter.can-add-entry : HorizontalBox {
        vertical-stretch: 0;

        Button {
            text: TranslationStrings.budget-add-entry;
            primary: true;
            clicked => { root.show-form = !root.show-form; }
        }
    }

    // Add entry form — visible only for Admin/Manager
    if root.show-form && BudgetPageAdapter.can-add-entry : GroupBox {
        vertical-stretch: 0;
        title: TranslationStrings.budget-new-entry;

        VerticalBox {
            HorizontalBox {
                spacing: 8px;

                VerticalBox {
                    horizontal-stretch: 1;
                    Text { text: TranslationStrings.budget-type; }
                    type-input := ComboBox {
                        horizontal-stretch: 1;
                        model: ["Purchase", "Sale", "Expense", "Forecast"];
                    }
                }

                VerticalBox {
                    horizontal-stretch: 1;
                    Text { text: TranslationStrings.budget-amount; }
                    amount-input := LineEdit { horizontal-stretch: 1; placeholder-text: TranslationStrings.budget-amount-placeholder; }
                }

                VerticalBox {
                    horizontal-stretch: 1;
                    Text { text: TranslationStrings.budget-date; }
                    Button {
                        horizontal-stretch: 1;
                        text: root.entry-date-text;
                        clicked => { entry-date-picker.show(); }
                    }
                }
            }

            HorizontalBox {
                spacing: 8px;

                VerticalBox {
                    horizontal-stretch: 1;
                    Text { text: TranslationStrings.budget-description-label; }
                    desc-input := LineEdit { horizontal-stretch: 1; placeholder-text: TranslationStrings.budget-description-placeholder; }
                }
            }

            HorizontalBox {
                alignment: end;
                spacing: 8px;

                Button {
                    text: TranslationStrings.common-cancel;
                    clicked => { root.show-form = false; }
                }

                Button {
                    text: TranslationStrings.common-record;
                    primary: true;
                    clicked => {
                        BudgetPageAdapter.record-entry(
                            type-input.current-value,
                            amount-input.text,
                            desc-input.text,
                            root.entry-date-text,
                            "",
                            ""
                        );
                        root.show-form = false;
                    }
                }
            }
        }
    }

    from-date-picker := DatePickerPopup {
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        accepted(date) => {
            root.from-date-text = date.year + "-" + date.month + "-" + date.day;
            BudgetPageAdapter.from-date = date.year + "-" + date.month + "-" + date.day;
        }
    }

    to-date-picker := DatePickerPopup {
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        accepted(date) => {
            root.to-date-text = date.year + "-" + date.month + "-" + date.day;
            BudgetPageAdapter.to-date = date.year + "-" + date.month + "-" + date.day;
        }
    }

    entry-date-picker := DatePickerPopup {
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        accepted(date) => {
            root.entry-date-text = date.year + "-" + date.month + "-" + date.day;
        }
    }
}
