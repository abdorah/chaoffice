// DashboardPage — Overview with KPIs and stock alerts

import { GroupBox, VerticalBox, HorizontalBox, StandardListView, Palette } from "std-widgets.slint";
import { Page } from "../components/page.slint";
import { StatCard } from "../components/stat_card.slint";
import { AppState } from "../globals/app_state.slint";
import { TranslationStrings } from "../globals/translation_strings.slint";

export component DashboardPage inherits Page {
    title: TranslationStrings.dashboard-title;
    description: TranslationStrings.dashboard-description;

    HorizontalBox {
        vertical-stretch: 0;
        spacing: 12px;

        StatCard {
            label: TranslationStrings.dashboard-total-products;
            value: AppState.total-products;
            accent-color: #4CAF50;
        }

        StatCard {
            label: TranslationStrings.dashboard-active-deals;
            value: AppState.active-deals;
            accent-color: #2196F3;
        }

        StatCard {
            label: TranslationStrings.dashboard-low-stock-items;
            value: AppState.low-stock-count;
            accent-color: #FF9800;
        }
    }

    HorizontalBox {
        vertical-stretch: 1;
        spacing: 12px;

        GroupBox {
            title: TranslationStrings.dashboard-stock-alerts;
            horizontal-stretch: 1;

            VerticalBox {
                alignment: start;

                for alert in AppState.stock-alerts : Rectangle {
                    height: 40px;
                    border-radius: 4px;
                    background: Palette.background.darker(0.05);

                    HorizontalBox {
                        padding: 8px;

                        Text {
                            text: alert.product-name;
                            horizontal-stretch: 1;
                        }

                        Text {
                            text: TranslationStrings.dashboard-qty-prefix + alert.quantity;
                            color: #FF9800;
                        }

                        Text {
                            text: alert.location-name;
                            color: Palette.foreground.transparentize(0.4);
                        }
                    }
                }
            }
        }

        GroupBox {
            title: TranslationStrings.dashboard-sync-status;
            horizontal-stretch: 0;
            min-width: 220px;

            VerticalBox {
                spacing: 8px;

                HorizontalBox {
                    Text { text: TranslationStrings.dashboard-status; }
                    Text {
                        text: AppState.sync-status.is-online ? TranslationStrings.dashboard-online : TranslationStrings.dashboard-local;
                        color: AppState.sync-status.is-online ? #4CAF50 : #2196F3;
                    }
                }

                HorizontalBox {
                    Text { text: TranslationStrings.dashboard-last-sync; }
                    Text { text: AppState.sync-status.last-sync-at; }
                }

                HorizontalBox {
                    Text { text: TranslationStrings.dashboard-pending; }
                    Text { text: AppState.sync-status.pending-changes; }
                }
            }
        }
    }
}
