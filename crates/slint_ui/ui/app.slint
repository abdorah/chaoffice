// Inventory Manager — Main Application Shell

import { Palette, Button, HorizontalBox, ComboBox } from "std-widgets.slint";
import { SideBar } from "components/side_bar.slint";
import { LoginPage } from "pages/login_page.slint";
import { DashboardPage } from "pages/dashboard_page.slint";
import { ProductsPage } from "pages/products_page.slint";
import { CategoriesPage, CategoriesPageAdapter } from "pages/categories_page.slint";
import { PersonsPage } from "pages/persons_page.slint";
import { DealsPage } from "pages/deals_page.slint";
import { LocationsPage } from "pages/locations_page.slint";
import { StockTrackingPage, StockTrackingAdapter } from "pages/stock_tracking_page.slint";
import { BudgetPage, BudgetPageAdapter } from "pages/budget_page.slint";
import { ReportsPage } from "pages/reports_page.slint";
import { UsersPage, UsersPageAdapter } from "pages/users_page.slint";
import { SyncPage, SyncPageAdapter } from "pages/sync_page.slint";
import { AppSettings } from "globals/app_settings.slint";
import { AppState } from "globals/app_state.slint";
import { TranslationStrings } from "globals/translation_strings.slint";
import { ProductsPageAdapter } from "pages/products_page.slint";
import { PersonsPageAdapter } from "pages/persons_page.slint";
import { DealsPageAdapter } from "pages/deals_page.slint";
import { LocationsPageAdapter } from "pages/locations_page.slint";

export { AppState, AppSettings, TranslationStrings, StockTrackingAdapter,
         BudgetPageAdapter, ProductsPageAdapter, PersonsPageAdapter,
         DealsPageAdapter, LocationsPageAdapter, UsersPageAdapter,
         CategoriesPageAdapter, SyncPageAdapter }

export component App inherits Window {
    preferred-width: 1024px;
    preferred-height: 700px;
    title: "Inventory Manager";

    // Show login screen when not authenticated
    if !AppState.is-authenticated : LoginPage {
        login(user, pass) => { AppState.login(user, pass); }
    }

    // Main app shell when authenticated
    if AppState.is-authenticated : VerticalLayout {
        // Helper: map current-locale string to ComboBox index
        property <int> locale-index: TranslationStrings.current-locale == "fr" ? 1
                                   : TranslationStrings.current-locale == "ar" ? 2
                                   : 0;

        // LTR top bar: user info on left, language switcher and logout on right
        if !TranslationStrings.is-rtl : HorizontalBox {
            vertical-stretch: 0;
            height: 40px;
            padding: 8px;

            Text {
                text: TranslationStrings.app-logged-in-prefix + AppState.current-user;
                vertical-alignment: center;
                color: Palette.foreground.transparentize(0.3);
            }

            Rectangle { horizontal-stretch: 1; }

            lang-combo-ltr := ComboBox {
                model: ["English", "Français", "العربية"];
                current-index: locale-index;
                selected(value) => {
                    TranslationStrings.change-locale(self.current-index);
                }
            }

            Button {
                text: TranslationStrings.common-logout;
                clicked => { AppState.logout(); }
            }
        }

        // RTL top bar: logout and language switcher on left, user info on right
        if TranslationStrings.is-rtl : HorizontalBox {
            vertical-stretch: 0;
            height: 40px;
            padding: 8px;

            Button {
                text: TranslationStrings.common-logout;
                clicked => { AppState.logout(); }
            }

            lang-combo-rtl := ComboBox {
                model: ["English", "Français", "العربية"];
                current-index: locale-index;
                selected(value) => {
                    TranslationStrings.change-locale(self.current-index);
                }
            }

            Rectangle { horizontal-stretch: 1; }

            Text {
                text: TranslationStrings.app-logged-in-prefix + AppState.current-user;
                vertical-alignment: center;
                horizontal-alignment: right;
                color: Palette.foreground.transparentize(0.3);
            }
        }

        HorizontalLayout {
            vertical-stretch: 1;

            side-bar := SideBar {
                title: TranslationStrings.nav-sidebar-title;
                model: [
                    TranslationStrings.nav-dashboard,
                    TranslationStrings.nav-products,
                    TranslationStrings.nav-categories,
                    TranslationStrings.nav-people,
                    TranslationStrings.nav-purchasing,
                    TranslationStrings.nav-locations,
                    TranslationStrings.nav-stock-tracking,
                    TranslationStrings.nav-budget,
                    TranslationStrings.nav-reports,
                    TranslationStrings.nav-users,
                    TranslationStrings.nav-sync,
                ];
            }

            if (side-bar.current-item == 0) : DashboardPage {}
            if (side-bar.current-item == 1) : ProductsPage {}
            if (side-bar.current-item == 2) : CategoriesPage {}
            if (side-bar.current-item == 3) : PersonsPage {}
            if (side-bar.current-item == 4) : DealsPage {}
            if (side-bar.current-item == 5) : LocationsPage {}
            if (side-bar.current-item == 6) : StockTrackingPage {}
            if (side-bar.current-item == 7) : BudgetPage {}
            if (side-bar.current-item == 8) : ReportsPage {}
            if (side-bar.current-item == 9) : UsersPage {}
            if (side-bar.current-item == 10) : SyncPage {}
        }
    }
}
