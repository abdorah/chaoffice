// Page — Base page component with title, description, and dark mode toggle

import { Switch, HorizontalBox, VerticalBox, Palette, ScrollView } from "std-widgets.slint";
import { AppSettings } from "../globals/app_settings.slint";
import { TranslationStrings } from "../globals/translation_strings.slint";

export component Page inherits VerticalLayout {
    in property <string> title: "title";
    in property <string> description: "description";

    vertical-stretch: 1;
    horizontal-stretch: 1;

    accessible-role: tab-panel;
    accessible-label: root.title;

    // Apply dark mode from settings — keeps running until palette matches
    Timer {
        interval: 200ms;
        running: AppSettings.dark-mode && Palette.color-scheme != ColorScheme.dark;
        triggered => {
            Palette.color-scheme = ColorScheme.dark;
        }
    }

    // LTR title bar: title on left, dark mode switch on right
    if !TranslationStrings.is-rtl : HorizontalBox {
        vertical-stretch: 0;
        Text {
            font-size: 20px;
            text <=> root.title;
        }

        Rectangle { }

        Switch {
            horizontal-stretch: 0;
            text: TranslationStrings.common-dark-mode;
            checked <=> AppSettings.dark-mode;
            toggled => {
                Palette.color-scheme = self.checked ? ColorScheme.dark : ColorScheme.light;
                AppSettings.dark-mode-changed(self.checked);
            }
        }
    }

    // RTL title bar: dark mode switch on left, title on right
    if TranslationStrings.is-rtl : HorizontalBox {
        vertical-stretch: 0;
        Switch {
            horizontal-stretch: 0;
            text: TranslationStrings.common-dark-mode;
            checked <=> AppSettings.dark-mode;
            toggled => {
                Palette.color-scheme = self.checked ? ColorScheme.dark : ColorScheme.light;
                AppSettings.dark-mode-changed(self.checked);
            }
        }

        Rectangle { }

        Text {
            font-size: 20px;
            text <=> root.title;
            horizontal-alignment: right;
        }
    }

    if root.description != "" : Text {
        vertical-stretch: 0;
        text: root.description;
        wrap: word-wrap;
        color: Palette.foreground.transparentize(0.4);
        horizontal-alignment: TranslationStrings.is-rtl ? right : left;
    }

    ScrollView {
        vertical-stretch: 1;
        horizontal-stretch: 1;

        VerticalBox {
            @children
        }
    }
}
