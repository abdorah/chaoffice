// ConfirmDialog — Modal confirmation overlay

import { Button, VerticalBox, HorizontalBox, Palette } from "std-widgets.slint";

export component ConfirmDialog inherits Rectangle {
    in property <string> message: "Are you sure?";
    in property <string> confirm-text: "Confirm";
    in property <string> cancel-text: "Cancel";
    in-out property <bool> show: false;

    callback confirmed();
    callback cancelled();

    if root.show : Rectangle {
        width: 100%;
        height: 100%;
        background: #00000080;

        Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: 360px;
            height: content.preferred-height + 32px;
            border-radius: 8px;
            background: Palette.background;

            content := VerticalBox {
                padding: 16px;
                spacing: 16px;

                Text {
                    text: root.message;
                    wrap: word-wrap;
                    horizontal-alignment: center;
                }

                HorizontalBox {
                    alignment: center;
                    spacing: 12px;

                    Button {
                        text: root.cancel-text;
                        clicked => {
                            root.show = false;
                            root.cancelled();
                        }
                    }

                    Button {
                        text: root.confirm-text;
                        primary: true;
                        clicked => {
                            root.show = false;
                            root.confirmed();
                        }
                    }
                }
            }
        }
    }
}
