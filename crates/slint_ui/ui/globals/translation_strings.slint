// Global translation strings for internationalization (i18n)
// Every translatable UI string is exposed as a property with English defaults.
// Rust-side TranslationManager sets these properties when the locale changes.

export global TranslationStrings {
    // ── Metadata ──────────────────────────────────────────────
    in property <string> current-locale: "en";
    in property <bool> is-rtl: false;
    callback change-locale(int);

    // ── App ───────────────────────────────────────────────────
    in property <string> app-title: "Inventory Manager";
    in property <string> app-logged-in-as: "Logged in as: {username}";
