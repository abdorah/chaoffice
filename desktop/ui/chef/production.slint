import { Button, VerticalBox, HorizontalBox, LineEdit, ListView } from "std-widgets.slint";

// Data model for recipe availability list
export struct RecipeAvailabilityItem {
    recipe-id: string,
    recipe-name: string,
    finished-good-name: string,
    max-producible: int,
    status: string,
    insufficient-materials: string,
}

// Chef Production Screen — Req 24.8
// Recipe availability list, production execution form
export component ChefProductionView inherits Rectangle {
    in property <[RecipeAvailabilityItem]> recipe-availability-list;
    in property <bool> is-loading: false;
    in property <string> error-message: "";
    in property <string> success-message: "";

    callback execute-production(string /* recipe_id */, int /* quantity */);
    callback refresh-production();

    VerticalLayout {
        padding: 24px;
        spacing: 16px;

        Text {
            text: "🏭 شاشة الإنتاج";
            font-size: 24px;
            font-weight: 700;
        }
        Text {
            text: "اختر وصفة وحدد الكمية لبدء الإنتاج";
            font-size: 15px;
            color: #7f8c8d;
        }

        // Loading indicator
        if root.is-loading: Text {
            text: "جاري التحميل...";
            font-size: 14px;
            color: #3498db;
        }

        // Error message
        if root.error-message != "": Rectangle {
            background: #fdecea;
            border-radius: 4px;
            min-height: 32px;
            VerticalLayout {
                padding: 8px;
                Text {
                    text: root.error-message;
                    font-size: 13px;
                    color: #c0392b;
                    wrap: word-wrap;
                }
            }
        }

        // Success message
        if root.success-message != "": Rectangle {
            background: #e8f8f5;
            border-radius: 4px;
            min-height: 32px;
            VerticalLayout {
                padding: 8px;
                Text {
                    text: root.success-message;
                    font-size: 13px;
                    color: #27ae60;
                    wrap: word-wrap;
                }
            }
        }

        HorizontalLayout {
            spacing: 16px;

            // ── Left panel: Production execution form ──
            Rectangle {
                background: #ecf0f1;
                border-radius: 8px;
                min-width: 340px;
                VerticalLayout {
                    padding: 16px;
                    spacing: 10px;

                    Text { text: "▶ تنفيذ الإنتاج"; font-size: 16px; font-weight: 600; }

                    Text { text: "معرف الوصفة"; font-size: 13px; }
                    recipe-input := LineEdit {
                        placeholder-text: "أدخل معرف الوصفة";
                        enabled: !root.is-loading;
                    }

                    Text { text: "كمية الإنتاج"; font-size: 13px; }
                    quantity-input := LineEdit {
                        placeholder-text: "أدخل الكمية المطلوبة";
                        enabled: !root.is-loading;
                    }

                    HorizontalLayout {
                        spacing: 8px;
                        Button {
                            text: "تنفيذ الإنتاج";
                            enabled: !root.is-loading;
                            clicked => {
                                root.execute-production(recipe-input.text, max(1, quantity-input.text.to-float()));
                            }
                        }
                        Button {
                            text: "تحديث";
                            enabled: !root.is-loading;
                            clicked => { root.refresh-production(); }
                        }
                    }
                }
            }

            // ── Right panel: Recipe availability list ──
            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 16px;

                Rectangle {
                    background: #ecf0f1;
                    border-radius: 8px;
                    vertical-stretch: 1;
                    VerticalLayout {
                        padding: 16px;
                        spacing: 10px;

                        Text { text: "📋 الوصفات المتاحة"; font-size: 16px; font-weight: 600; }

                        // Table header
                        HorizontalLayout {
                            spacing: 8px;
                            Text { text: "الوصفة"; font-size: 13px; font-weight: 600; horizontal-stretch: 2; }
                            Text { text: "المنتج النهائي"; font-size: 13px; font-weight: 600; horizontal-stretch: 2; }
                            Text { text: "أقصى كمية"; font-size: 13px; font-weight: 600; horizontal-stretch: 1; }
                            Text { text: "الحالة"; font-size: 13px; font-weight: 600; horizontal-stretch: 1; }
                        }

                        Rectangle { height: 1px; background: #bdc3c7; }

                        ListView {
                            vertical-stretch: 1;
                            for item in root.recipe-availability-list: HorizontalLayout {
                                spacing: 8px;
                                height: 36px;
                                Text { text: item.recipe-name; font-size: 13px; horizontal-stretch: 2; overflow: elide; }
                                Text { text: item.finished-good-name; font-size: 13px; horizontal-stretch: 2; overflow: elide; }
                                Text { text: item.max-producible; font-size: 13px; horizontal-stretch: 1; }
                                Text {
                                    text: item.status;
                                    font-size: 13px;
                                    horizontal-stretch: 1;
                                    color: item.max-producible > 0 ? #27ae60 : #c0392b;
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
