import { Button, VerticalBox, HorizontalBox, LineEdit, ListView } from "std-widgets.slint";

// Data struct for a wallet row
export struct WalletItem {
    id: string,
    name: string,
    wallet-type: string,
    balance: string,
}

// Data struct for a transaction row
export struct TransactionItem {
    id: string,
    wallet-id: string,
    amount: string,
    description: string,
    timestamp: string,
}

// Wallet Management — Req 24.5
// Wallet list with balances, transaction history, fund transfer
// Wired to SweetLabCore.get_wallets(), get_transaction_history(), transfer_funds()
export component WalletsView inherits Rectangle {
    // Data properties populated from Rust via AppWindow
    in property <[WalletItem]> wallet-list;
    in property <[TransactionItem]> transaction-list;
    in property <bool> is-loading: false;
    in property <string> error-message: "";
    in property <string> success-message: "";

    // Callbacks to Rust
    callback transfer-funds(string /* source_wallet_id */, string /* dest_wallet_id */, string /* amount */);
    callback load-transactions(string /* wallet_id */);
    callback refresh-wallets();

    VerticalLayout {
        padding: 24px;
        spacing: 16px;

        // Header row with title and refresh button
        HorizontalLayout {
            spacing: 12px;
            Text {
                text: "إدارة المحافظ";
                font-size: 24px;
                font-weight: 700;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
            Button {
                text: is-loading ? "⏳ جاري التحديث..." : "🔄 تحديث";
                enabled: !is-loading;
                clicked => { root.refresh-wallets(); }
            }
        }

        Text {
            text: "عرض الأرصدة وسجل المعاملات وتحويل الأموال";
            font-size: 15px;
            color: #7f8c8d;
        }

        // Error message
        if error-message != "": Rectangle {
            background: #e74c3c;
            border-radius: 6px;
            min-height: 36px;
            VerticalLayout {
                padding: 8px;
                Text { text: root.error-message; color: white; font-size: 13px; }
            }
        }

        // Success message
        if success-message != "": Rectangle {
            background: #27ae60;
            border-radius: 6px;
            min-height: 36px;
            VerticalLayout {
                padding: 8px;
                Text { text: root.success-message; color: white; font-size: 13px; }
            }
        }

        // Wallet balances list
        Rectangle {
            background: #ecf0f1;
            border-radius: 8px;
            VerticalLayout {
                padding: 16px;
                spacing: 10px;

                Text { text: "💰 أرصدة المحافظ"; font-size: 16px; font-weight: 600; }

                // Table header
                HorizontalLayout {
                    spacing: 8px;
                    Text { text: "الاسم"; font-size: 13px; font-weight: 600; horizontal-stretch: 2; }
                    Text { text: "النوع"; font-size: 13px; font-weight: 600; horizontal-stretch: 1; }
                    Text { text: "الرصيد"; font-size: 13px; font-weight: 600; horizontal-stretch: 1; }
                    Text { text: "المعاملات"; font-size: 13px; font-weight: 600; width: 100px; }
                }

                Rectangle { height: 1px; background: #bdc3c7; }

                if wallet-list.length == 0 && !is-loading: Text {
                    text: "لا توجد محافظ";
                    font-size: 13px;
                    color: #95a5a6;
                }

                ListView {
                    min-height: 100px;
                    for wallet[idx] in root.wallet-list: Rectangle {
                        height: 44px;
                        background: Math.mod(idx, 2) == 0 ? #ffffff : #f8f9fa;
                        border-radius: 4px;
                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            spacing: 8px;
                            Text {
                                text: wallet.name;
                                font-size: 13px;
                                vertical-alignment: center;
                                horizontal-stretch: 2;
                            }
                            Text {
                                text: wallet.wallet-type;
                                font-size: 13px;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                                color: #7f8c8d;
                            }
                            Text {
                                text: wallet.balance;
                                font-size: 13px;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                                font-weight: 600;
                            }
                            Button {
                                text: "📜";
                                width: 100px;
                                clicked => { root.load-transactions(wallet.id); }
                            }
                        }
                    }
                }
            }
        }

        HorizontalLayout {
            spacing: 16px;

            // Fund transfer form
            Rectangle {
                background: #ecf0f1;
                border-radius: 8px;
                min-width: 300px;
                VerticalLayout {
                    padding: 16px;
                    spacing: 10px;

                    Text { text: "💸 تحويل أموال"; font-size: 16px; font-weight: 600; }

                    Text { text: "معرف المحفظة المصدر"; font-size: 13px; }
                    source-input := LineEdit {
                        placeholder-text: "أدخل معرف المحفظة المصدر (UUID)";
                    }

                    Text { text: "معرف المحفظة الهدف"; font-size: 13px; }
                    dest-input := LineEdit {
                        placeholder-text: "أدخل معرف المحفظة الهدف (UUID)";
                    }

                    Text { text: "المبلغ"; font-size: 13px; }
                    amount-input := LineEdit {
                        placeholder-text: "أدخل المبلغ";
                        input-type: decimal;
                    }

                    HorizontalLayout {
                        spacing: 8px;
                        Button {
                            text: root.is-loading ? "⏳ جاري التحويل..." : "تنفيذ التحويل";
                            enabled: !root.is-loading;
                            clicked => {
                                root.transfer-funds(
                                    source-input.text,
                                    dest-input.text,
                                    amount-input.text,
                                );
                                source-input.text = "";
                                dest-input.text = "";
                                amount-input.text = "";
                            }
                        }
                        Button {
                            text: "مسح";
                            clicked => {
                                source-input.text = "";
                                dest-input.text = "";
                                amount-input.text = "";
                            }
                        }
                    }
                }
            }

            // Transaction history
            Rectangle {
                background: #ecf0f1;
                border-radius: 8px;
                horizontal-stretch: 1;
                VerticalLayout {
                    padding: 16px;
                    spacing: 10px;

                    Text { text: "📜 سجل المعاملات"; font-size: 16px; font-weight: 600; }

                    // Table header
                    HorizontalLayout {
                        spacing: 8px;
                        Text { text: "التاريخ"; font-size: 13px; font-weight: 600; horizontal-stretch: 1; }
                        Text { text: "الوصف"; font-size: 13px; font-weight: 600; horizontal-stretch: 2; }
                        Text { text: "المبلغ"; font-size: 13px; font-weight: 600; horizontal-stretch: 1; }
                    }

                    Rectangle { height: 1px; background: #bdc3c7; }

                    if transaction-list.length == 0 && !is-loading: Text {
                        text: "اختر محفظة لعرض المعاملات";
                        font-size: 13px;
                        color: #95a5a6;
                    }

                    ListView {
                        min-height: 200px;
                        vertical-stretch: 1;
                        for tx[idx] in root.transaction-list: Rectangle {
                            height: 40px;
                            background: Math.mod(idx, 2) == 0 ? #ffffff : #f8f9fa;
                            border-radius: 4px;
                            HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 8px;
                                spacing: 8px;
                                Text {
                                    text: tx.timestamp;
                                    font-size: 12px;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                    color: #7f8c8d;
                                }
                                Text {
                                    text: tx.description;
                                    font-size: 13px;
                                    vertical-alignment: center;
                                    horizontal-stretch: 2;
                                }
                                Text {
                                    text: tx.amount;
                                    font-size: 13px;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                    font-weight: 600;
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
