import { Button, VerticalBox, HorizontalBox, LineEdit } from "std-widgets.slint";

// Reports — Req 10.2, 11.4, 12.1, 12.2, 12.3, 12.4
// Financial summary, inventory report, debt aging, expense report
// Will be wired to SweetLabCore report methods
export component ReportsView inherits Rectangle {
    VerticalLayout {
        padding: 24px;
        spacing: 16px;

        Text {
            text: "التقارير";
            font-size: 24px;
            font-weight: 700;
        }
        Text {
            text: "التقارير المالية وتقارير المخزون والديون والمصروفات";
            font-size: 15px;
            color: #7f8c8d;
        }

        // Date range filter
        HorizontalLayout {
            spacing: 12px;
            alignment: start;

            Text { text: "من تاريخ:"; font-size: 13px; vertical-alignment: center; }
            start-date := LineEdit {
                placeholder-text: "YYYY-MM-DD";
                width: 140px;
            }
            Text { text: "إلى تاريخ:"; font-size: 13px; vertical-alignment: center; }
            end-date := LineEdit {
                placeholder-text: "YYYY-MM-DD";
                width: 140px;
            }
            Button {
                text: "تحديث";
                // TODO: Refresh reports with selected date range
            }
        }

        // Report cards grid (2x2)
        HorizontalLayout {
            spacing: 16px;

            // Financial summary — Req 12.1
            // SweetLabCore.get_financial_summary(start, end)
            Rectangle {
                background: #ecf0f1;
                border-radius: 8px;
                horizontal-stretch: 1;
                vertical-stretch: 1;
                VerticalLayout {
                    padding: 16px;
                    spacing: 8px;

                    Text { text: "💰 الملخص المالي"; font-size: 16px; font-weight: 600; }

                    HorizontalLayout {
                        spacing: 4px;
                        Text { text: "إجمالي الإيرادات:"; font-size: 13px; }
                        Text { text: "—"; font-size: 13px; color: #27ae60; }
                        // TODO: total_revenue from SweetLabCore.get_financial_summary()
                    }
                    HorizontalLayout {
                        spacing: 4px;
                        Text { text: "إجمالي المصروفات:"; font-size: 13px; }
                        Text { text: "—"; font-size: 13px; color: #e74c3c; }
                        // TODO: total_expenses from SweetLabCore.get_financial_summary()
                    }
                    HorizontalLayout {
                        spacing: 4px;
                        Text { text: "صافي الربح:"; font-size: 13px; font-weight: 600; }
                        Text { text: "—"; font-size: 13px; font-weight: 600; }
                        // TODO: net_profit from SweetLabCore.get_financial_summary()
                    }
                }
            }

            // Inventory report — Req 12.2
            // SweetLabCore.get_inventory_report(threshold)
            Rectangle {
                background: #ecf0f1;
                border-radius: 8px;
                horizontal-stretch: 1;
                vertical-stretch: 1;
                VerticalLayout {
                    padding: 16px;
                    spacing: 8px;

                    Text { text: "📦 تقرير المخزون"; font-size: 16px; font-weight: 600; }
                    Text {
                        text: "المواد والمنتجات مع تنبيهات المخزون المنخفض";
                        font-size: 12px;
                        color: #7f8c8d;
                    }
                    // TODO: Display raw materials + finished goods with low-stock highlights
                    // SweetLabCore.get_inventory_report(low_stock_threshold)
                    Text {
                        text: "— سيتم تحميل تقرير المخزون من SweetLabCore —";
                        font-size: 12px;
                        color: #95a5a6;
                    }
                }
            }
        }

        HorizontalLayout {
            spacing: 16px;

            // Debt aging report — Req 10.2
            // SweetLabCore.get_debt_aging_report()
            Rectangle {
                background: #ecf0f1;
                border-radius: 8px;
                horizontal-stretch: 1;
                vertical-stretch: 1;
                VerticalLayout {
                    padding: 16px;
                    spacing: 8px;

                    Text { text: "📊 تقرير أعمار الديون"; font-size: 16px; font-weight: 600; }

                    // Table header — sorted by overdue days descending
                    HorizontalLayout {
                        spacing: 8px;
                        Text { text: "العميل"; font-size: 12px; font-weight: 600; horizontal-stretch: 2; }
                        Text { text: "المبلغ"; font-size: 12px; font-weight: 600; horizontal-stretch: 1; }
                        Text { text: "أيام التأخير"; font-size: 12px; font-weight: 600; horizontal-stretch: 1; }
                        Text { text: "الحالة"; font-size: 12px; font-weight: 600; horizontal-stretch: 1; }
                    }
                    Rectangle { height: 1px; background: #bdc3c7; }

                    // TODO: populate from SweetLabCore.get_debt_aging_report()
                    // Sorted by overdue_days descending, critical flag for > 30 days
                    Text {
                        text: "— سيتم تحميل تقرير الديون من SweetLabCore —";
                        font-size: 12px;
                        color: #95a5a6;
                    }
                }
            }

            // Expense report — Req 11.4
            // SweetLabCore.get_expenses_by_category()
            Rectangle {
                background: #ecf0f1;
                border-radius: 8px;
                horizontal-stretch: 1;
                vertical-stretch: 1;
                VerticalLayout {
                    padding: 16px;
                    spacing: 8px;

                    Text { text: "💸 تقرير المصروفات"; font-size: 16px; font-weight: 600; }

                    // Grouped by category with subtotals
                    HorizontalLayout {
                        spacing: 8px;
                        Text { text: "الفئة"; font-size: 12px; font-weight: 600; horizontal-stretch: 2; }
                        Text { text: "المجموع الفرعي"; font-size: 12px; font-weight: 600; horizontal-stretch: 1; }
                    }
                    Rectangle { height: 1px; background: #bdc3c7; }

                    // TODO: populate from SweetLabCore expenses grouped by category
                    // Req 11.4: grouped by category, subtotals, grand total
                    Text {
                        text: "— سيتم تحميل تقرير المصروفات من SweetLabCore —";
                        font-size: 12px;
                        color: #95a5a6;
                    }
                }
            }
        }

        // Export buttons — Req 12.4
        HorizontalLayout {
            spacing: 12px;
            alignment: start;

            Button {
                text: "📄 تصدير PDF";
                // TODO: Call SweetLabCore.export_to_pdf()
            }
            Button {
                text: "📊 تصدير Excel";
                // TODO: Call SweetLabCore.export_to_excel()
            }
        }
    }
}
