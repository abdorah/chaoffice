import { Button, VerticalBox, HorizontalBox, ListView } from "std-widgets.slint";

// Data struct for a raw material row
export struct RawMaterialItem {
    id: string,
    name: string,
    unit: string,
    current-quantity: string,
    last-updated: string,
}

// Data struct for a finished good row
export struct FinishedGoodItem {
    id: string,
    name: string,
    current-quantity: string,
    unit-price: string,
    last-updated: string,
}

// Inventory Management — Req 24.3
// Raw materials list + Finished goods list
// Wired to SweetLabCore.get_raw_materials(), get_finished_goods()
export component InventoryView inherits Rectangle {
    // Data properties populated from Rust via AppWindow
    in property <[RawMaterialItem]> raw-materials;
    in property <[FinishedGoodItem]> finished-goods;
    in property <bool> is-loading: false;
    in property <string> error-message: "";

    // Callback to request data refresh from Rust
    callback refresh();

    VerticalLayout {
        padding: 24px;
        spacing: 16px;

        // Header row with title and refresh button
        HorizontalLayout {
            spacing: 12px;
            Text {
                text: "إدارة المخزون";
                font-size: 24px;
                font-weight: 700;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
            Button {
                text: is-loading ? "⏳ جاري التحديث..." : "🔄 تحديث";
                enabled: !is-loading;
                clicked => { root.refresh(); }
            }
        }

        Text {
            text: "متابعة المواد الخام والمنتجات النهائية";
            font-size: 15px;
            color: #7f8c8d;
        }

        // Error message
        if error-message != "": Rectangle {
            background: #e74c3c;
            border-radius: 6px;
            min-height: 36px;
            VerticalLayout {
                padding: 8px;
                Text { text: root.error-message; color: white; font-size: 13px; }
            }
        }

        // Raw Materials section
        Rectangle {
            background: #ecf0f1;
            border-radius: 8px;
            vertical-stretch: 1;
            VerticalLayout {
                padding: 16px;
                spacing: 10px;

                Text { text: "📦 المواد الخام"; font-size: 16px; font-weight: 600; }

                // Table header
                HorizontalLayout {
                    spacing: 8px;
                    Text { text: "الاسم"; font-size: 13px; font-weight: 600; horizontal-stretch: 2; }
                    Text { text: "الوحدة"; font-size: 13px; font-weight: 600; horizontal-stretch: 1; }
                    Text { text: "الكمية"; font-size: 13px; font-weight: 600; horizontal-stretch: 1; }
                    Text { text: "آخر تحديث"; font-size: 13px; font-weight: 600; horizontal-stretch: 2; }
                }

                Rectangle { height: 1px; background: #bdc3c7; }

                if raw-materials.length == 0 && !is-loading: Rectangle {
                    min-height: 40px;
                    VerticalLayout {
                        padding: 8px;
                        Text {
                            text: "لا توجد مواد خام";
                            font-size: 13px;
                            color: #95a5a6;
                        }
                    }
                }

                for item in raw-materials: HorizontalLayout {
                    spacing: 8px;
                    Text { text: item.name; font-size: 13px; horizontal-stretch: 2; }
                    Text { text: item.unit; font-size: 13px; horizontal-stretch: 1; color: #7f8c8d; }
                    Text { text: item.current-quantity; font-size: 13px; horizontal-stretch: 1; font-weight: 600; }
                    Text { text: item.last-updated; font-size: 13px; horizontal-stretch: 2; color: #95a5a6; }
                }
            }
        }

        // Finished Goods section
        Rectangle {
            background: #ecf0f1;
            border-radius: 8px;
            vertical-stretch: 1;
            VerticalLayout {
                padding: 16px;
                spacing: 10px;

                Text { text: "🎁 المنتجات النهائية"; font-size: 16px; font-weight: 600; }

                // Table header
                HorizontalLayout {
                    spacing: 8px;
                    Text { text: "الاسم"; font-size: 13px; font-weight: 600; horizontal-stretch: 2; }
                    Text { text: "الكمية"; font-size: 13px; font-weight: 600; horizontal-stretch: 1; }
                    Text { text: "سعر الوحدة"; font-size: 13px; font-weight: 600; horizontal-stretch: 1; }
                    Text { text: "آخر تحديث"; font-size: 13px; font-weight: 600; horizontal-stretch: 2; }
                }

                Rectangle { height: 1px; background: #bdc3c7; }

                if finished-goods.length == 0 && !is-loading: Rectangle {
                    min-height: 40px;
                    VerticalLayout {
                        padding: 8px;
                        Text {
                            text: "لا توجد منتجات نهائية";
                            font-size: 13px;
                            color: #95a5a6;
                        }
                    }
                }

                for item in finished-goods: HorizontalLayout {
                    spacing: 8px;
                    Text { text: item.name; font-size: 13px; horizontal-stretch: 2; }
                    Text { text: item.current-quantity; font-size: 13px; horizontal-stretch: 1; font-weight: 600; }
                    Text { text: item.unit-price; font-size: 13px; horizontal-stretch: 1; color: #27ae60; }
                    Text { text: item.last-updated; font-size: 13px; horizontal-stretch: 2; color: #95a5a6; }
                }
            }
        }
    }
}
