import { Button, VerticalBox, LineEdit } from "std-widgets.slint";

// ── Login Panel ──────────────────────────────────────────────────────
// Req 1.1: Valid credentials → authenticate and create session
// Req 1.2: Invalid credentials → descriptive error without revealing which field is wrong
// Req 1.3: Role-based redirect after login
export component LoginPanel inherits Rectangle {
    callback login(string /* username */, string /* password */);

    in-out property <string> error-message: "";
    in-out property <bool> is-loading: false;

    VerticalLayout {
        alignment: center;
        padding: 40px;
        spacing: 16px;

        Text {
            text: "مصنع الحلويات - Sweet Lab";
            font-size: 28px;
            horizontal-alignment: center;
            font-weight: 700;
        }

        Text {
            text: "تسجيل الدخول";
            font-size: 18px;
            horizontal-alignment: center;
        }

        // Username
        Text {
            text: "اسم المستخدم";
            font-size: 14px;
        }
        username-input := LineEdit {
            placeholder-text: "أدخل اسم المستخدم";
            enabled: !root.is-loading;
        }

        // Password
        Text {
            text: "كلمة المرور";
            font-size: 14px;
        }
        password-input := LineEdit {
            placeholder-text: "أدخل كلمة المرور";
            input-type: password;
            enabled: !root.is-loading;
        }

        // Error message — generic per Req 1.2 (does not reveal which field is wrong)
        if error-message != "": Text {
            text: root.error-message;
            color: red;
            font-size: 13px;
            horizontal-alignment: center;
        }

        // Loading indicator
        if root.is-loading: Text {
            text: "جارٍ تسجيل الدخول...";
            font-size: 13px;
            color: #7f8c8d;
            horizontal-alignment: center;
        }

        Button {
            text: root.is-loading ? "جارٍ الدخول..." : "دخول";
            enabled: !root.is-loading;
            clicked => {
                root.login(username-input.text, password-input.text);
            }
        }
    }
}
