import { Button, VerticalBox, HorizontalBox, LineEdit, ComboBox, ListView } from "std-widgets.slint";

// Data model for an expense history item
export struct ExpenseItem {
    id: string,
    description: string,
    amount: string,
    category: string,
    wallet-name: string,
    timestamp: string,
}

// Data model for a wallet option in the expense form
export struct ExpenseWalletItem {
    id: string,
    name: string,
    balance: string,
}

// Representative Expense Recording Screen — Req 24.11
export component RepresentativeExpensesView inherits Rectangle {
    // Data properties (populated from Rust)
    in property <[ExpenseItem]> expenses-list;
    // Wallet names list for ComboBox (populated from Rust alongside expense-wallet-list)
    in property <[string]> expense-wallet-names;
    in property <[ExpenseWalletItem]> expense-wallet-list;
    in property <bool> is-loading: false;
    in property <string> error-message: "";
    in property <string> success-message: "";

    // Callbacks wired to Rust
    callback record-expense(string /* description */, string /* amount */, string /* category */, string /* wallet_id */);
    callback refresh-expenses();

    VerticalLayout {
        padding: 24px;
        spacing: 16px;

        Text {
            text: "💸 تسجيل المصروفات";
            font-size: 24px;
            font-weight: 700;
        }
        Text {
            text: "تسجيل المشتريات والتكاليف التشغيلية من المحفظة";
            font-size: 15px;
            color: #7f8c8d;
        }

        // Status messages
        if root.error-message != "": Rectangle {
            background: #fadbd8;
            border-radius: 4px;
            min-height: 30px;
            VerticalLayout {
                padding: 8px;
                Text { text: root.error-message; font-size: 13px; color: #c0392b; }
            }
        }
        if root.success-message != "": Rectangle {
            background: #d5f5e3;
            border-radius: 4px;
            min-height: 30px;
            VerticalLayout {
                padding: 8px;
                Text { text: root.success-message; font-size: 13px; color: #27ae60; }
            }
        }

        // Loading indicator
        if root.is-loading: Text {
            text: "جاري التحميل...";
            font-size: 14px;
            color: #3498db;
        }

        HorizontalLayout {
            spacing: 16px;

            // ── Left panel: Expense form ──
            Rectangle {
                background: #ecf0f1;
                border-radius: 8px;
                min-width: 340px;
                VerticalLayout {
                    padding: 16px;
                    spacing: 10px;

                    Text { text: "➕ تسجيل مصروف جديد"; font-size: 16px; font-weight: 600; }

                    Text { text: "الوصف"; font-size: 13px; }
                    description-input := LineEdit {
                        placeholder-text: "أدخل وصف المصروف";
                    }

                    Text { text: "المبلغ"; font-size: 13px; }
                    amount-input := LineEdit {
                        placeholder-text: "أدخل المبلغ";
                        input-type: decimal;
                    }

                    // Category — Purchase or OperatingCost
                    Text { text: "الفئة"; font-size: 13px; }
                    category-combo := ComboBox {
                        model: ["مشتريات", "تكاليف تشغيلية"];
                        current-index: 0;
                        current-value: "مشتريات";
                    }

                    // Wallet selector
                    Text { text: "المحفظة"; font-size: 13px; }
                    wallet-combo := ComboBox {
                        model: root.expense-wallet-names;
                        current-index: 0;
                    }

                    // Wallet balance display
                    if root.expense-wallet-list.length > 0 && wallet-combo.current-index >= 0 && wallet-combo.current-index < root.expense-wallet-list.length: Rectangle {
                        background: #fef9e7;
                        border-radius: 4px;
                        min-height: 30px;
                        VerticalLayout {
                            padding: 8px;
                            Text {
                                text: "رصيد المحفظة: " + root.expense-wallet-list[wallet-combo.current-index].balance;
                                font-size: 12px;
                                color: #7d6608;
                            }
                        }
                    }

                    HorizontalLayout {
                        spacing: 8px;
                        Button {
                            text: "تسجيل المصروف";
                            enabled: !root.is-loading;
                            clicked => {
                                if (root.expense-wallet-list.length > 0 && wallet-combo.current-index >= 0 && wallet-combo.current-index < root.expense-wallet-list.length) {
                                    root.record-expense(
                                        description-input.text,
                                        amount-input.text,
                                        category-combo.current-value,
                                        root.expense-wallet-list[wallet-combo.current-index].id,
                                    );
                                }
                            }
                        }
                        Button {
                            text: "مسح";
                            clicked => {
                                description-input.text = "";
                                amount-input.text = "";
                                category-combo.current-index = 0;
                            }
                        }
                        Button {
                            text: "🔄 تحديث";
                            enabled: !root.is-loading;
                            clicked => { root.refresh-expenses(); }
                        }
                    }
                }
            }

            // ── Right panel: Expense history ──
            Rectangle {
                background: #ecf0f1;
                border-radius: 8px;
                horizontal-stretch: 1;
                VerticalLayout {
                    padding: 16px;
                    spacing: 10px;

                    Text { text: "📜 سجل المصروفات"; font-size: 16px; font-weight: 600; }

                    // Table header
                    HorizontalLayout {
                        spacing: 8px;
                        Text { text: "الوصف"; font-size: 13px; font-weight: 600; horizontal-stretch: 2; }
                        Text { text: "المبلغ"; font-size: 13px; font-weight: 600; horizontal-stretch: 1; }
                        Text { text: "الفئة"; font-size: 13px; font-weight: 600; horizontal-stretch: 1; }
                        Text { text: "المحفظة"; font-size: 13px; font-weight: 600; horizontal-stretch: 1; }
                        Text { text: "التاريخ"; font-size: 13px; font-weight: 600; horizontal-stretch: 2; }
                    }

                    Rectangle { height: 1px; background: #bdc3c7; }

                    ListView {
                        min-height: 300px;
                        vertical-stretch: 1;
                        for expense in root.expenses-list: HorizontalLayout {
                            spacing: 8px;
                            padding-top: 4px;
                            padding-bottom: 4px;
                            Text { text: expense.description; font-size: 13px; horizontal-stretch: 2; overflow: elide; }
                            Text { text: expense.amount; font-size: 13px; horizontal-stretch: 1; }
                            Text { text: expense.category; font-size: 13px; horizontal-stretch: 1; }
                            Text { text: expense.wallet-name; font-size: 13px; horizontal-stretch: 1; }
                            Text { text: expense.timestamp; font-size: 13px; horizontal-stretch: 2; color: #7f8c8d; }
                        }
                    }
                }
            }
        }
    }
}
