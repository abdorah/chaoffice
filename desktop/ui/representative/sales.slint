import { Button, VerticalBox, HorizontalBox, LineEdit, ListView } from "std-widgets.slint";

// Data model for a customer in the dropdown
export struct SalesCustomerItem {
    id: string,
    name: string,
    city: string,
}

// Data model for a finished good available for sale
export struct SalesFinishedGoodItem {
    id: string,
    name: string,
    unit-price: string,
    current-quantity: string,
}

// Data model for a wallet option
export struct SalesWalletItem {
    id: string,
    name: string,
}

// Data model for a sale history row
export struct SaleHistoryItem {
    id: string,
    customer-name: string,
    total-amount: string,
    amount-paid: string,
    timestamp: string,
}

// Representative Sales Screen — Req 24.9
// Sale creation with customer selection, line item entry, and payment
export component RepresentativeSalesView inherits Rectangle {
    // Data properties populated from Rust
    in property <[SalesCustomerItem]> customer-list;
    in property <[SalesFinishedGoodItem]> finished-goods-list;
    in property <[SalesWalletItem]> wallet-list;
    in property <[SaleHistoryItem]> sales-history;
    in property <bool> is-loading: false;
    in property <string> error-message: "";
    in property <string> success-message: "";

    // Callbacks to Rust
    callback create-sale(string /* customer_id */, string /* line_items_json */, string /* amount_paid */, string /* wallet_id */);
    callback refresh-sales();

    VerticalLayout {
        padding: 24px;
        spacing: 16px;

        Text {
            text: "🛒 شاشة المبيعات";
            font-size: 24px;
            font-weight: 700;
        }
        Text {
            text: "تسجيل عمليات البيع — اختر العميل والمنتجات ثم سجّل البيع";
            font-size: 15px;
            color: #7f8c8d;
        }

        // Loading indicator
        if root.is-loading: Text {
            text: "جاري التحميل...";
            font-size: 14px;
            color: #3498db;
        }

        // Error message
        if root.error-message != "": Rectangle {
            background: #fdecea;
            border-radius: 4px;
            min-height: 32px;
            VerticalLayout {
                padding: 8px;
                Text {
                    text: root.error-message;
                    font-size: 13px;
                    color: #c0392b;
                    wrap: word-wrap;
                }
            }
        }

        // Success message
        if root.success-message != "": Rectangle {
            background: #e8f8f5;
            border-radius: 4px;
            min-height: 32px;
            VerticalLayout {
                padding: 8px;
                Text {
                    text: root.success-message;
                    font-size: 13px;
                    color: #27ae60;
                    wrap: word-wrap;
                }
            }
        }

        HorizontalLayout {
            spacing: 16px;

            // ── Left panel: Sale creation form ──
            Rectangle {
                background: #ecf0f1;
                border-radius: 8px;
                min-width: 380px;
                VerticalLayout {
                    padding: 16px;
                    spacing: 10px;

                    Text { text: "➕ عملية بيع جديدة"; font-size: 16px; font-weight: 600; }

                    // Customer ID input
                    Text { text: "معرف العميل"; font-size: 13px; }
                    customer-input := LineEdit {
                        placeholder-text: "أدخل معرف العميل";
                        enabled: !root.is-loading;
                    }

                    // Available customers list
                    Text { text: "العملاء المتاحون"; font-size: 13px; font-weight: 600; }
                    Rectangle {
                        background: white;
                        border-radius: 4px;
                        max-height: 100px;
                        ListView {
                            for cust in root.customer-list: HorizontalLayout {
                                spacing: 8px;
                                height: 28px;
                                Text { text: cust.name; font-size: 12px; horizontal-stretch: 2; overflow: elide; }
                                Text { text: cust.city; font-size: 12px; horizontal-stretch: 1; color: #7f8c8d; overflow: elide; }
                                Text { text: cust.id; font-size: 10px; horizontal-stretch: 2; color: #95a5a6; overflow: elide; }
                            }
                        }
                    }

                    // Line items JSON input
                    // Format: [{"finished_good_id":"...","finished_good_name":"...","quantity":N,"unit_price":"..."}]
                    Text { text: "بنود البيع (JSON)"; font-size: 13px; }
                    line-items-input := LineEdit {
                        placeholder-text: "[{\"finished_good_id\":\"...\",\"quantity\":1,\"unit_price\":\"...\"}]";
                        enabled: !root.is-loading;
                    }

                    // Available finished goods
                    Text { text: "المنتجات المتاحة"; font-size: 13px; font-weight: 600; }
                    Rectangle {
                        background: white;
                        border-radius: 4px;
                        max-height: 100px;
                        ListView {
                            for fg in root.finished-goods-list: HorizontalLayout {
                                spacing: 8px;
                                height: 28px;
                                Text { text: fg.name; font-size: 12px; horizontal-stretch: 2; overflow: elide; }
                                Text { text: fg.unit-price; font-size: 12px; horizontal-stretch: 1; color: #27ae60; }
                                Text { text: "كمية: " + fg.current-quantity; font-size: 11px; horizontal-stretch: 1; color: #7f8c8d; }
                            }
                        }
                    }

                    // Amount paid
                    Text { text: "المبلغ المدفوع"; font-size: 13px; }
                    amount-paid-input := LineEdit {
                        placeholder-text: "أدخل المبلغ المدفوع";
                        input-type: decimal;
                        enabled: !root.is-loading;
                    }

                    // Wallet ID input
                    Text { text: "معرف المحفظة"; font-size: 13px; }
                    wallet-input := LineEdit {
                        placeholder-text: "أدخل معرف المحفظة";
                        enabled: !root.is-loading;
                    }

                    // Available wallets
                    if root.wallet-list.length > 0: Rectangle {
                        background: white;
                        border-radius: 4px;
                        max-height: 60px;
                        ListView {
                            for w in root.wallet-list: HorizontalLayout {
                                spacing: 8px;
                                height: 24px;
                                Text { text: w.name; font-size: 12px; horizontal-stretch: 1; }
                                Text { text: w.id; font-size: 10px; horizontal-stretch: 2; color: #95a5a6; overflow: elide; }
                            }
                        }
                    }

                    // Remaining balance note
                    Rectangle {
                        background: #fef9e7;
                        border-radius: 4px;
                        min-height: 30px;
                        VerticalLayout {
                            padding: 8px;
                            Text {
                                text: "ملاحظة: المبلغ المتبقي سيُسجل كدين على العميل";
                                font-size: 12px;
                                color: #7d6608;
                            }
                        }
                    }

                    HorizontalLayout {
                        spacing: 8px;
                        Button {
                            text: "تسجيل البيع";
                            enabled: !root.is-loading;
                            clicked => {
                                root.create-sale(
                                    customer-input.text,
                                    line-items-input.text,
                                    amount-paid-input.text,
                                    wallet-input.text,
                                );
                            }
                        }
                        Button {
                            text: "تحديث";
                            enabled: !root.is-loading;
                            clicked => { root.refresh-sales(); }
                        }
                    }
                }
            }

            // ── Right panel: Sales history ──
            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 16px;

                Rectangle {
                    background: #ecf0f1;
                    border-radius: 8px;
                    vertical-stretch: 1;
                    VerticalLayout {
                        padding: 16px;
                        spacing: 10px;

                        Text { text: "📜 سجل المبيعات"; font-size: 16px; font-weight: 600; }

                        // Table header
                        HorizontalLayout {
                            spacing: 8px;
                            Text { text: "العميل"; font-size: 13px; font-weight: 600; horizontal-stretch: 2; }
                            Text { text: "الإجمالي"; font-size: 13px; font-weight: 600; horizontal-stretch: 1; }
                            Text { text: "المدفوع"; font-size: 13px; font-weight: 600; horizontal-stretch: 1; }
                            Text { text: "التاريخ"; font-size: 13px; font-weight: 600; horizontal-stretch: 2; }
                        }

                        Rectangle { height: 1px; background: #bdc3c7; }

                        ListView {
                            vertical-stretch: 1;
                            for sale in root.sales-history: HorizontalLayout {
                                spacing: 8px;
                                height: 36px;
                                Text { text: sale.customer-name; font-size: 13px; horizontal-stretch: 2; overflow: elide; }
                                Text { text: sale.total-amount; font-size: 13px; horizontal-stretch: 1; }
                                Text { text: sale.amount-paid; font-size: 13px; horizontal-stretch: 1; color: #27ae60; }
                                Text { text: sale.timestamp; font-size: 13px; horizontal-stretch: 2; overflow: elide; }
                            }
                        }
                    }
                }
            }
        }
    }
}
