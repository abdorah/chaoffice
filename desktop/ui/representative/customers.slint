import { Button, VerticalBox, HorizontalBox, LineEdit } from "std-widgets.slint";

// Representative Customer Management Screen — Req 7.1, 7.2, 7.3, 7.4, 7.5
// Customer list with search, customer profile with debt summary, create form, rating update
// Will be wired to SweetLabCore.create_customer(), search_customers(), update_reliability_rating()
export component RepresentativeCustomersView inherits Rectangle {
    // TODO: Wire callbacks to SweetLabCore via Rust main.rs
    // callback create-customer(string /* name */, string /* city */, string /* mobile */);
    // callback search-customers(string /* query */);
    // callback update-rating(string /* customer_id */, int /* rating */);

    VerticalLayout {
        padding: 24px;
        spacing: 16px;

        Text {
            text: "👤 إدارة العملاء";
            font-size: 24px;
            font-weight: 700;
        }
        Text {
            text: "إنشاء وإدارة ملفات العملاء وتقييم الموثوقية";
            font-size: 15px;
            color: #7f8c8d;
        }

        HorizontalLayout {
            spacing: 16px;

            // ── Left panel: Create customer form (Req 7.1) ──
            Rectangle {
                background: #ecf0f1;
                border-radius: 8px;
                min-width: 320px;
                VerticalLayout {
                    padding: 16px;
                    spacing: 10px;

                    Text { text: "➕ إنشاء عميل جديد"; font-size: 16px; font-weight: 600; }

                    // Req 7.1: name, city, mobile
                    Text { text: "اسم العميل"; font-size: 13px; }
                    name-input := LineEdit {
                        placeholder-text: "أدخل اسم العميل";
                    }

                    Text { text: "المدينة"; font-size: 13px; }
                    city-input := LineEdit {
                        placeholder-text: "أدخل المدينة";
                    }

                    Text { text: "رقم الهاتف"; font-size: 13px; }
                    mobile-input := LineEdit {
                        placeholder-text: "أدخل رقم الهاتف";
                        // Req 7.3: Mobile must be unique
                    }

                    HorizontalLayout {
                        spacing: 8px;
                        Button {
                            text: "إنشاء العميل";
                            // TODO: Call SweetLabCore.create_customer(name, city, mobile)
                            // Req 7.1: Initial rating = 0
                            // Req 7.3: Reject duplicate mobile
                        }
                        Button {
                            text: "مسح";
                        }
                    }

                    // ── Rating update section (Req 7.2) ──
                    Rectangle { height: 1px; background: #bdc3c7; }

                    Text { text: "⭐ تحديث تقييم الموثوقية"; font-size: 16px; font-weight: 600; }

                    Text { text: "العميل"; font-size: 13px; }
                    rating-customer-input := LineEdit {
                        placeholder-text: "اختر العميل";
                        // TODO: Replace with customer picker
                    }

                    Text { text: "التقييم (1-5)"; font-size: 13px; }
                    rating-input := LineEdit {
                        placeholder-text: "أدخل التقييم من 1 إلى 5";
                        input-type: decimal;
                        // Req 7.2: Accept [1,5] only
                    }

                    Button {
                        text: "تحديث التقييم";
                        // TODO: Call SweetLabCore.update_reliability_rating(customer_id, rating)
                    }
                }
            }

            // ── Right panel: Customer list + profile ──
            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 16px;

                // Search bar — Req 7.4
                HorizontalLayout {
                    spacing: 8px;
                    search-input := LineEdit {
                        horizontal-stretch: 1;
                        placeholder-text: "بحث بالاسم أو المدينة أو رقم الهاتف";
                        // Req 7.4: Search by name, city, or mobile
                    }
                    Button {
                        text: "🔍 بحث";
                        // TODO: Call SweetLabCore.search_customers(query)
                    }
                }

                // Customer list — SweetLabCore.search_customers() / get_customers()
                Rectangle {
                    background: #ecf0f1;
                    border-radius: 8px;
                    vertical-stretch: 1;
                    VerticalLayout {
                        padding: 16px;
                        spacing: 10px;

                        Text { text: "📋 قائمة العملاء"; font-size: 16px; font-weight: 600; }

                        // Table header
                        HorizontalLayout {
                            spacing: 8px;
                            Text { text: "الاسم"; font-size: 13px; font-weight: 600; horizontal-stretch: 2; }
                            Text { text: "المدينة"; font-size: 13px; font-weight: 600; horizontal-stretch: 1; }
                            Text { text: "الهاتف"; font-size: 13px; font-weight: 600; horizontal-stretch: 1; }
                            Text { text: "التقييم"; font-size: 13px; font-weight: 600; horizontal-stretch: 1; }
                            Text { text: "الديون"; font-size: 13px; font-weight: 600; horizontal-stretch: 1; }
                        }

                        Rectangle { height: 1px; background: #bdc3c7; }

                        // Placeholder — TODO: populate from SweetLabCore
                        Rectangle {
                            min-height: 120px;
                            vertical-stretch: 1;
                            VerticalLayout {
                                padding: 8px;
                                Text {
                                    text: "— سيتم تحميل قائمة العملاء من SweetLabCore —";
                                    font-size: 13px;
                                    color: #95a5a6;
                                }
                                // TODO: ListView of Customer items
                                // Each row: name | city | mobile | rating (stars) | total_debt
                            }
                        }
                    }
                }

                // Customer profile detail — Req 7.5
                Rectangle {
                    background: #ecf0f1;
                    border-radius: 8px;
                    min-height: 140px;
                    VerticalLayout {
                        padding: 16px;
                        spacing: 8px;

                        Text { text: "📄 ملف العميل"; font-size: 16px; font-weight: 600; }

                        // Req 7.5: name, city, mobile, rating, total debt, overdue days
                        HorizontalLayout {
                            spacing: 16px;
                            VerticalLayout {
                                spacing: 4px;
                                horizontal-stretch: 1;
                                HorizontalLayout {
                                    spacing: 4px;
                                    Text { text: "الاسم:"; font-size: 13px; font-weight: 600; }
                                    Text { text: "—"; font-size: 13px; color: #7f8c8d; }
                                }
                                HorizontalLayout {
                                    spacing: 4px;
                                    Text { text: "المدينة:"; font-size: 13px; font-weight: 600; }
                                    Text { text: "—"; font-size: 13px; color: #7f8c8d; }
                                }
                                HorizontalLayout {
                                    spacing: 4px;
                                    Text { text: "الهاتف:"; font-size: 13px; font-weight: 600; }
                                    Text { text: "—"; font-size: 13px; color: #7f8c8d; }
                                }
                            }
                            VerticalLayout {
                                spacing: 4px;
                                horizontal-stretch: 1;
                                HorizontalLayout {
                                    spacing: 4px;
                                    Text { text: "التقييم:"; font-size: 13px; font-weight: 600; }
                                    Text { text: "⭐ —"; font-size: 13px; color: #f39c12; }
                                }
                                HorizontalLayout {
                                    spacing: 4px;
                                    Text { text: "إجمالي الديون:"; font-size: 13px; font-weight: 600; }
                                    Text { text: "—"; font-size: 13px; color: #e74c3c; }
                                }
                                HorizontalLayout {
                                    spacing: 4px;
                                    Text { text: "أيام التأخير:"; font-size: 13px; font-weight: 600; }
                                    Text { text: "—"; font-size: 13px; color: #e74c3c; }
                                }
                            }
                        }
                        // TODO: Populate from selected customer in list
                        // SweetLabCore provides total_debt and overdue_days on Customer struct
                    }
                }
            }
        }
    }
}
