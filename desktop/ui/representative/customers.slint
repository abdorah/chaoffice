import { Button, VerticalBox, HorizontalBox, LineEdit, ListView } from "std-widgets.slint";

// Data model for a customer row in the list
export struct CustomerItem {
    id: string,
    name: string,
    city: string,
    phone: string,
    reliability-rating: int,
    total-debt: string,
}

// Representative Customer Management Screen — Req 24.10
// Customer list with search, create customer form, rating update
// Wired to SweetLabCore.search_customers(), create_customer(), update_reliability_rating()
export component RepresentativeCustomersView inherits Rectangle {
    // Data properties populated from Rust
    in property <[CustomerItem]> customer-list;
    in property <bool> is-loading: false;
    in property <string> error-message: "";
    in property <string> success-message: "";

    // Callbacks to Rust
    callback search-customers(string /* query */);
    callback create-customer(string /* name */, string /* city */, string /* mobile */);
    callback update-rating(string /* customer_id */, int /* rating */);
    callback refresh-customers();

    VerticalLayout {
        padding: 24px;
        spacing: 16px;

        Text {
            text: "👤 إدارة العملاء";
            font-size: 24px;
            font-weight: 700;
        }
        Text {
            text: "إنشاء وإدارة ملفات العملاء وتقييم الموثوقية";
            font-size: 15px;
            color: #7f8c8d;
        }

        // Loading / error / success indicators
        if root.is-loading: Text {
            text: "⏳ جاري التحميل...";
            font-size: 14px;
            color: #3498db;
        }
        if root.error-message != "": Text {
            text: root.error-message;
            font-size: 14px;
            color: #e74c3c;
        }
        if root.success-message != "": Text {
            text: root.success-message;
            font-size: 14px;
            color: #27ae60;
        }

        HorizontalLayout {
            spacing: 16px;

            // ── Left panel: Create customer form ──
            Rectangle {
                background: #ecf0f1;
                border-radius: 8px;
                min-width: 320px;
                VerticalLayout {
                    padding: 16px;
                    spacing: 10px;

                    Text { text: "➕ إنشاء عميل جديد"; font-size: 16px; font-weight: 600; }

                    Text { text: "اسم العميل"; font-size: 13px; }
                    name-input := LineEdit {
                        placeholder-text: "أدخل اسم العميل";
                    }

                    Text { text: "المدينة"; font-size: 13px; }
                    city-input := LineEdit {
                        placeholder-text: "أدخل المدينة";
                    }

                    Text { text: "رقم الهاتف"; font-size: 13px; }
                    mobile-input := LineEdit {
                        placeholder-text: "أدخل رقم الهاتف";
                    }

                    HorizontalLayout {
                        spacing: 8px;
                        Button {
                            text: "إنشاء العميل";
                            enabled: !root.is-loading;
                            clicked => {
                                root.create-customer(name-input.text, city-input.text, mobile-input.text);
                            }
                        }
                        Button {
                            text: "مسح";
                            clicked => {
                                name-input.text = "";
                                city-input.text = "";
                                mobile-input.text = "";
                            }
                        }
                    }

                    // ── Rating update section ──
                    Rectangle { height: 1px; background: #bdc3c7; }

                    Text { text: "⭐ تحديث تقييم الموثوقية"; font-size: 16px; font-weight: 600; }

                    Text { text: "معرف العميل"; font-size: 13px; }
                    rating-customer-input := LineEdit {
                        placeholder-text: "أدخل معرف العميل";
                    }

                    Text { text: "التقييم (1-5)"; font-size: 13px; }
                    rating-input := LineEdit {
                        placeholder-text: "أدخل التقييم من 1 إلى 5";
                        input-type: decimal;
                    }

                    Button {
                        text: "تحديث التقييم";
                        enabled: !root.is-loading;
                        clicked => {
                            root.update-rating(rating-customer-input.text, max(1, min(5, rating-input.text.to-float())));
                        }
                    }
                }
            }

            // ── Right panel: Customer list + search ──
            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 16px;

                // Search bar
                HorizontalLayout {
                    spacing: 8px;
                    search-input := LineEdit {
                        horizontal-stretch: 1;
                        placeholder-text: "بحث بالاسم أو المدينة أو رقم الهاتف";
                    }
                    Button {
                        text: "🔍 بحث";
                        enabled: !root.is-loading;
                        clicked => {
                            root.search-customers(search-input.text);
                        }
                    }
                    Button {
                        text: "🔄 تحديث";
                        enabled: !root.is-loading;
                        clicked => {
                            root.refresh-customers();
                        }
                    }
                }

                // Customer list table
                Rectangle {
                    background: #ecf0f1;
                    border-radius: 8px;
                    vertical-stretch: 1;
                    VerticalLayout {
                        padding: 16px;
                        spacing: 10px;

                        Text { text: "📋 قائمة العملاء"; font-size: 16px; font-weight: 600; }

                        // Table header
                        HorizontalLayout {
                            spacing: 8px;
                            Text { text: "الاسم"; font-size: 13px; font-weight: 600; horizontal-stretch: 2; }
                            Text { text: "المدينة"; font-size: 13px; font-weight: 600; horizontal-stretch: 1; }
                            Text { text: "الهاتف"; font-size: 13px; font-weight: 600; horizontal-stretch: 1; }
                            Text { text: "التقييم"; font-size: 13px; font-weight: 600; horizontal-stretch: 1; }
                            Text { text: "الديون"; font-size: 13px; font-weight: 600; horizontal-stretch: 1; }
                        }

                        Rectangle { height: 1px; background: #bdc3c7; }

                        ListView {
                            vertical-stretch: 1;
                            for customer in root.customer-list: HorizontalLayout {
                                spacing: 8px;
                                height: 32px;
                                Text { text: customer.name; font-size: 13px; horizontal-stretch: 2; overflow: elide; }
                                Text { text: customer.city; font-size: 13px; horizontal-stretch: 1; overflow: elide; }
                                Text { text: customer.phone; font-size: 13px; horizontal-stretch: 1; overflow: elide; }
                                Text { text: "⭐ \{customer.reliability-rating}"; font-size: 13px; horizontal-stretch: 1; color: #f39c12; }
                                Text { text: customer.total-debt; font-size: 13px; horizontal-stretch: 1; color: #e74c3c; }
                            }
                        }
                    }
                }
            }
        }
    }
}
