import { Button, VerticalBox, HorizontalBox, LineEdit, ComboBox, ListView } from "std-widgets.slint";

// Data model for an active debt record item
export struct DebtItem {
    id: string,
    customer-id: string,
    customer-name: string,
    sale-date: string,
    original-amount: string,
    remaining-amount: string,
    overdue-days: int,
    is-critical: bool,
}

// Data model for a wallet option in the payment form
export struct PaymentWalletItem {
    id: string,
    name: string,
    balance: string,
}

// Data model for a customer option in the payment form
export struct PaymentCustomerItem {
    id: string,
    name: string,
    total-debt: string,
    overdue-days: int,
}

// Representative Customer Payment Screen — Req 24.12
// Customer picker with debt summary, payment amount, wallet selector, FIFO allocation
// Wired to SweetLabCore.record_debt_payment(), get_active_debts(), get_wallets()
export component RepresentativePaymentsView inherits Rectangle {
    // Data properties (populated from Rust)
    in property <[DebtItem]> debts-list;
    in property <[PaymentWalletItem]> payment-wallet-list;
    in property <[string]> payment-wallet-names;
    in property <[PaymentCustomerItem]> payment-customer-list;
    in property <[string]> payment-customer-names;
    in property <bool> is-loading: false;
    in property <string> error-message: "";
    in property <string> success-message: "";

    // Callbacks wired to Rust
    callback record-payment(string /* customer_id */, string /* amount */, string /* wallet_id */);
    callback refresh-payments();

    VerticalLayout {
        padding: 24px;
        spacing: 16px;

        Text {
            text: "💳 تحصيل الديون";
            font-size: 24px;
            font-weight: 700;
        }
        Text {
            text: "تسجيل مدفوعات العملاء وتسوية الديون";
            font-size: 15px;
            color: #7f8c8d;
        }

        // Status messages
        if root.error-message != "": Rectangle {
            background: #fadbd8;
            border-radius: 4px;
            min-height: 30px;
            VerticalLayout {
                padding: 8px;
                Text { text: root.error-message; font-size: 13px; color: #c0392b; }
            }
        }
        if root.success-message != "": Rectangle {
            background: #d5f5e3;
            border-radius: 4px;
            min-height: 30px;
            VerticalLayout {
                padding: 8px;
                Text { text: root.success-message; font-size: 13px; color: #27ae60; }
            }
        }

        // Loading indicator
        if root.is-loading: Text {
            text: "جاري التحميل...";
            font-size: 14px;
            color: #3498db;
        }

        HorizontalLayout {
            spacing: 16px;

            // ── Left panel: Payment form ──
            Rectangle {
                background: #ecf0f1;
                border-radius: 8px;
                min-width: 340px;
                VerticalLayout {
                    padding: 16px;
                    spacing: 10px;

                    Text { text: "➕ تسجيل دفعة جديدة"; font-size: 16px; font-weight: 600; }

                    // Customer picker
                    Text { text: "العميل"; font-size: 13px; }
                    customer-combo := ComboBox {
                        model: root.payment-customer-names;
                        current-index: 0;
                    }

                    // Customer debt summary display
                    if root.payment-customer-list.length > 0 && customer-combo.current-index >= 0 && customer-combo.current-index < root.payment-customer-list.length: Rectangle {
                        background: white;
                        border-radius: 4px;
                        min-height: 70px;
                        VerticalLayout {
                            padding: 10px;
                            spacing: 4px;
                            Text { text: "ملخص ديون العميل"; font-size: 13px; font-weight: 600; }
                            HorizontalLayout {
                                spacing: 4px;
                                Text { text: "إجمالي الديون:"; font-size: 12px; }
                                Text {
                                    text: root.payment-customer-list[customer-combo.current-index].total-debt;
                                    font-size: 12px;
                                    color: #e74c3c;
                                }
                            }
                            HorizontalLayout {
                                spacing: 4px;
                                Text { text: "أيام التأخير:"; font-size: 12px; }
                                Text {
                                    text: root.payment-customer-list[customer-combo.current-index].overdue-days;
                                    font-size: 12px;
                                    color: #e74c3c;
                                }
                            }
                        }
                    }

                    // Payment amount
                    Text { text: "مبلغ الدفعة"; font-size: 13px; }
                    amount-input := LineEdit {
                        placeholder-text: "أدخل مبلغ الدفعة";
                        input-type: decimal;
                    }

                    // Wallet selector
                    Text { text: "المحفظة"; font-size: 13px; }
                    wallet-combo := ComboBox {
                        model: root.payment-wallet-names;
                        current-index: 0;
                    }

                    // Wallet balance display
                    if root.payment-wallet-list.length > 0 && wallet-combo.current-index >= 0 && wallet-combo.current-index < root.payment-wallet-list.length: Rectangle {
                        background: #fef9e7;
                        border-radius: 4px;
                        min-height: 30px;
                        VerticalLayout {
                            padding: 8px;
                            Text {
                                text: "رصيد المحفظة: " + root.payment-wallet-list[wallet-combo.current-index].balance;
                                font-size: 12px;
                                color: #7d6608;
                            }
                        }
                    }

                    // FIFO allocation note
                    Rectangle {
                        background: #eaf2f8;
                        border-radius: 4px;
                        min-height: 40px;
                        VerticalLayout {
                            padding: 8px;
                            Text {
                                text: "ℹ️ سيتم تطبيق الدفعة على أقدم الديون أولاً (FIFO)";
                                font-size: 12px;
                                color: #2471a3;
                            }
                        }
                    }

                    HorizontalLayout {
                        spacing: 8px;
                        Button {
                            text: "تسجيل الدفعة";
                            enabled: !root.is-loading;
                            clicked => {
                                if (root.payment-customer-list.length > 0
                                    && customer-combo.current-index >= 0
                                    && customer-combo.current-index < root.payment-customer-list.length
                                    && root.payment-wallet-list.length > 0
                                    && wallet-combo.current-index >= 0
                                    && wallet-combo.current-index < root.payment-wallet-list.length) {
                                    root.record-payment(
                                        root.payment-customer-list[customer-combo.current-index].id,
                                        amount-input.text,
                                        root.payment-wallet-list[wallet-combo.current-index].id,
                                    );
                                }
                            }
                        }
                        Button {
                            text: "مسح";
                            clicked => {
                                amount-input.text = "";
                            }
                        }
                        Button {
                            text: "🔄 تحديث";
                            enabled: !root.is-loading;
                            clicked => { root.refresh-payments(); }
                        }
                    }
                }
            }

            // ── Right panel: Active debts list ──
            Rectangle {
                background: #ecf0f1;
                border-radius: 8px;
                horizontal-stretch: 1;
                VerticalLayout {
                    padding: 16px;
                    spacing: 10px;

                    Text { text: "📊 الديون النشطة"; font-size: 16px; font-weight: 600; }

                    // Table header
                    HorizontalLayout {
                        spacing: 8px;
                        Text { text: "العميل"; font-size: 13px; font-weight: 600; horizontal-stretch: 2; }
                        Text { text: "تاريخ البيع"; font-size: 13px; font-weight: 600; horizontal-stretch: 2; }
                        Text { text: "المبلغ الأصلي"; font-size: 13px; font-weight: 600; horizontal-stretch: 1; }
                        Text { text: "المتبقي"; font-size: 13px; font-weight: 600; horizontal-stretch: 1; }
                        Text { text: "أيام التأخير"; font-size: 13px; font-weight: 600; horizontal-stretch: 1; }
                    }

                    Rectangle { height: 1px; background: #bdc3c7; }

                    ListView {
                        min-height: 300px;
                        vertical-stretch: 1;
                        for debt in root.debts-list: HorizontalLayout {
                            spacing: 8px;
                            padding-top: 4px;
                            padding-bottom: 4px;
                            Text { text: debt.customer-name; font-size: 13px; horizontal-stretch: 2; overflow: elide; }
                            Text { text: debt.sale-date; font-size: 13px; horizontal-stretch: 2; color: #7f8c8d; }
                            Text { text: debt.original-amount; font-size: 13px; horizontal-stretch: 1; }
                            Text {
                                text: debt.remaining-amount;
                                font-size: 13px;
                                horizontal-stretch: 1;
                                color: debt.is-critical ? #e74c3c : #2c3e50;
                            }
                            Text {
                                text: debt.overdue-days;
                                font-size: 13px;
                                horizontal-stretch: 1;
                                color: debt.is-critical ? #e74c3c : #7f8c8d;
                            }
                        }
                    }
                }
            }
        }
    }
}
