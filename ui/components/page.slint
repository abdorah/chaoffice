// Page — Base page component with title, description, and dark mode toggle

import { Switch, HorizontalBox, VerticalBox, Palette, ScrollView } from "std-widgets.slint";
import { AppSettings } from "../globals/app_settings.slint";

export component Page inherits VerticalLayout {
    in property <string> title: "title";
    in property <string> description: "description";

    vertical-stretch: 1;
    horizontal-stretch: 1;

    accessible-role: tab-panel;
    accessible-label: root.title;

    // Apply dark mode from settings on startup via a one-shot timer
    Timer {
        interval: 100ms;
        running: true;
        triggered => {
            if AppSettings.dark-mode {
                Palette.color-scheme = ColorScheme.dark;
            }
            self.running = false;
        }
    }

    HorizontalBox {
        vertical-stretch: 0;
        Text {
            font-size: 20px;
            text <=> root.title;
        }

        Rectangle { }

        Switch {
            horizontal-stretch: 0;
            text: "Dark Mode";
            checked <=> AppSettings.dark-mode;
            toggled => {
                Palette.color-scheme = self.checked ? ColorScheme.dark : ColorScheme.light;
            }
        }
    }

    if root.description != "" : Text {
        vertical-stretch: 0;
        text: root.description;
        wrap: word-wrap;
        color: Palette.foreground.transparentize(0.4);
    }

    ScrollView {
        vertical-stretch: 1;
        horizontal-stretch: 1;

        VerticalBox {
            @children
        }
    }
}
