// UsersPage — User management (Admin only)

import { GroupBox, VerticalBox, HorizontalBox, StandardTableView, Button,
         LineEdit, ComboBox, Palette } from "std-widgets.slint";
import { Page } from "../components/page.slint";
import { SearchBar } from "../components/search_bar.slint";
import { AppState } from "../globals/app_state.slint";

export global UsersPageAdapter {
    in property <[[StandardListViewItem]]> row-data: [];
}

export component UsersPage inherits Page {
    property <bool> show-form: false;

    title: "User Management";
    description: "Create and manage user accounts and roles. Admin access required.";

    SearchBar {
        vertical-stretch: 0;
        placeholder: "Search users...";
        action-text: "Add User";
        action-clicked => { root.show-form = !root.show-form; }
    }

    if root.show-form : GroupBox {
        vertical-stretch: 0;
        title: "New User";

        VerticalBox {
            HorizontalBox {
                spacing: 8px;

                VerticalBox {
                    Text { text: "Username"; }
                    user-input := LineEdit { placeholder-text: "username"; }
                }

                VerticalBox {
                    Text { text: "Display Name"; }
                    name-input := LineEdit { placeholder-text: "Full name"; }
                }
            }

            HorizontalBox {
                spacing: 8px;

                VerticalBox {
                    Text { text: "Password"; }
                    pass-input := LineEdit {
                        placeholder-text: "Password";
                        input-type: InputType.password;
                    }
                }

                VerticalBox {
                    Text { text: "Role"; }
                    role-input := ComboBox {
                        model: ["Admin", "Manager", "Operator", "Viewer"];
                    }
                }
            }

            HorizontalBox {
                alignment: end;
                spacing: 8px;

                Button {
                    text: "Cancel";
                    clicked => { root.show-form = false; }
                }

                Button {
                    text: "Create";
                    primary: true;
                    clicked => {
                        AppState.create-user(
                            user-input.text,
                            pass-input.text,
                            name-input.text,
                            role-input.current-value
                        );
                        root.show-form = false;
                    }
                }
            }
        }
    }

    GroupBox {
        title: "Users";
        vertical-stretch: 1;

        StandardTableView {
            columns: [
                { title: "Username" },
                { title: "Display Name" },
                { title: "Role" },
                { title: "Active" },
            ];
            rows: UsersPageAdapter.row-data;
        }
    }
}
