// CategoriesPage — Category tree management

import { GroupBox, VerticalBox, HorizontalBox, StandardTableView, Button, LineEdit, Palette } from "std-widgets.slint";
import { Page } from "../components/page.slint";
import { SearchBar } from "../components/search_bar.slint";
import { AppState, CategoryItem } from "../globals/app_state.slint";

export global CategoriesPageAdapter {
    in property <[[StandardListViewItem]]> row-data: [];
}

export component CategoriesPage inherits Page {
    property <bool> show-form: false;

    title: "Categories";
    description: "Organize products into hierarchical categories.";

    SearchBar {
        vertical-stretch: 0;
        placeholder: "Search categories...";
        action-text: "Add Category";
        action-clicked => { root.show-form = !root.show-form; }
    }

    if root.show-form : GroupBox {
        vertical-stretch: 0;
        title: "New Category";

        VerticalBox {
            HorizontalBox {
                spacing: 8px;

                VerticalBox {
                    horizontal-stretch: 1;
                    Text { text: "Name"; }
                    name-input := LineEdit { horizontal-stretch: 1; placeholder-text: "Category name"; }
                }

                VerticalBox {
                    horizontal-stretch: 1;
                    Text { text: "Description"; }
                    desc-input := LineEdit { horizontal-stretch: 1; placeholder-text: "Description"; }
                }
            }

            HorizontalBox {
                alignment: end;
                spacing: 8px;

                Button {
                    text: "Cancel";
                    clicked => { root.show-form = false; }
                }

                Button {
                    text: "Create";
                    primary: true;
                    clicked => {
                        AppState.create-category(name-input.text, desc-input.text, 0);
                        root.show-form = false;
                    }
                }
            }
        }
    }

    GroupBox {
        title: "Categories";
        vertical-stretch: 1;

        StandardTableView {
            columns: [
                { title: "Name" },
                { title: "Description" },
            ];

            rows: CategoriesPageAdapter.row-data;
        }
    }
}
