// StockTrackingPage — Stock movement history with chart visualization

import { GroupBox, VerticalBox, HorizontalBox, StandardTableView, Button,
         ComboBox, SpinBox, LineEdit, Palette, StyleMetrics } from "std-widgets.slint";
import { Page } from "../components/page.slint";
import { LineChart } from "../components/line_chart.slint";
import { StatCard } from "../components/stat_card.slint";
import { AppState } from "../globals/app_state.slint";

export global StockTrackingAdapter {
    in property <[[StandardListViewItem]]> movement-rows: [];
    // SVG path string computed in Rust from stock history data
    in property <string> stock-trend-path: "";
    in property <string> stock-trend-fill: "";
    in property <[string]> trend-x-labels: [];
    // Product and location lists for form selectors
    in property <[string]> product-names: [];
    in property <[string]> location-names: [];
    // Error message from last record attempt
    in property <string> error-message: "";

    // Callbacks bridged to Rust controller
    callback record-movement(/* product */ string, /* type */ string, /* qty */ int,
                              /* from_loc */ string, /* to_loc */ string, /* note */ string);
    callback load-history(/* product */ string, /* from_date */ string, /* to_date */ string);
    callback load-summary();
}

export component StockTrackingPage inherits Page {
    property <bool> show-form: false;

    title: "Stock Tracking";
    description: "Track stock movements and visualize inventory trends over time.";

    HorizontalBox {
        vertical-stretch: 0;
        spacing: 12px;

        StatCard {
            label: "Total Inbound (30d)";
            value: AppState.stock-inbound-30d;
            accent-color: #4CAF50;
        }

        StatCard {
            label: "Total Outbound (30d)";
            value: AppState.stock-outbound-30d;
            accent-color: #FF9800;
        }

        StatCard {
            label: "Net Change (30d)";
            value: AppState.stock-net-30d;
            accent-color: #2196F3;
        }
    }

    LineChart {
        vertical-stretch: 0;
        min-height: 180px;
        title: "Stock Level Trend";
        svg-path: StockTrackingAdapter.stock-trend-path;
        fill-path: StockTrackingAdapter.stock-trend-fill;
        x-labels: StockTrackingAdapter.trend-x-labels;
        line-color: #2196F3;
    }

    HorizontalBox {
        vertical-stretch: 0;

        Button {
            text: "Record Movement";
            primary: true;
            clicked => { root.show-form = !root.show-form; }
        }
    }

    // Error message display
    if StockTrackingAdapter.error-message != "" : Rectangle {
        vertical-stretch: 0;
        background: #FFEBEE;
        border-radius: 4px;
        min-height: 32px;

        HorizontalBox {
            padding: 8px;
            Text {
                text: StockTrackingAdapter.error-message;
                color: #C62828;
                font-size: 13px;
                wrap: word-wrap;
            }
        }
    }

    if root.show-form : GroupBox {
        vertical-stretch: 0;
        title: "New Stock Movement";

        VerticalBox {
            HorizontalBox {
                spacing: 8px;

                VerticalBox {
                    Text { text: "Product"; }
                    product-input := ComboBox {
                        model: StockTrackingAdapter.product-names;
                    }
                }

                VerticalBox {
                    Text { text: "Type"; }
                    type-input := ComboBox {
                        model: ["Inbound", "Outbound", "Transfer", "Adjustment", "Return"];
                    }
                }

                VerticalBox {
                    Text { text: "Quantity"; }
                    qty-input := SpinBox { value: 1; minimum: 1; maximum: 999999; }
                }
            }

            HorizontalBox {
                spacing: 8px;

                VerticalBox {
                    Text { text: "From Location"; }
                    from-loc-input := ComboBox {
                        model: StockTrackingAdapter.location-names;
                    }
                }

                VerticalBox {
                    Text { text: "To Location"; }
                    to-loc-input := ComboBox {
                        model: StockTrackingAdapter.location-names;
                    }
                }
            }

            HorizontalBox {
                spacing: 8px;

                VerticalBox {
                    Text { text: "Note"; }
                    note-input := LineEdit { placeholder-text: "Movement note"; }
                }
            }

            HorizontalBox {
                alignment: end;
                spacing: 8px;

                Button {
                    text: "Cancel";
                    clicked => { root.show-form = false; }
                }

                Button {
                    text: "Record";
                    primary: true;
                    clicked => {
                        StockTrackingAdapter.record-movement(
                            product-input.current-value,
                            type-input.current-value,
                            qty-input.value,
                            from-loc-input.current-value,
                            to-loc-input.current-value,
                            note-input.text
                        );
                        // Don't close form — keep it open so errors are visible (Req 5.4)
                    }
                }
            }
        }
    }

    GroupBox {
        title: "Movement History";
        vertical-stretch: 1;

        StandardTableView {
            columns: [
                { title: "Date" },
                { title: "Type" },
                { title: "Product" },
                { title: "Qty" },
                { title: "From" },
                { title: "To" },
                { title: "User" },
                { title: "Note" },
            ];
            rows: StockTrackingAdapter.movement-rows;
        }
    }
}
