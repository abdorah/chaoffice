// SyncPage — TursoDB/LibSQL sync management (online/offline)

import { GroupBox, VerticalBox, HorizontalBox, Button, ProgressIndicator, Palette,
         LineEdit, Switch, SpinBox } from "std-widgets.slint";
import { Page } from "../components/page.slint";
import { StatCard } from "../components/stat_card.slint";
import { AppState } from "../globals/app_state.slint";

export component SyncPage inherits Page {
    property <bool> syncing: false;

    title: "Sync";
    description: "Manage online/offline synchronization with TursoDB via LibSQL.";

    HorizontalBox {
        vertical-stretch: 0;
        spacing: 12px;

        StatCard {
            label: "Pending Changes";
            value: AppState.sync-status.pending-changes;
            accent-color: AppState.sync-status.pending-changes > 0 ? #FF9800 : #4CAF50;
        }

        StatCard {
            label: "Connection";
            value: AppState.sync-status.is-online ? "Online" : "Local";
            accent-color: AppState.sync-status.is-online ? #4CAF50 : #2196F3;
        }
    }

    GroupBox {
        title: "Sync Actions";
        vertical-stretch: 0;

        VerticalBox {
            spacing: 12px;

            HorizontalBox {
                Text { text: "Last synchronized:"; }
                Text {
                    text: AppState.sync-status.last-sync-at;
                    color: Palette.foreground.transparentize(0.3);
                }
            }

            if root.syncing : ProgressIndicator {
                indeterminate: true;
            }

            HorizontalBox {
                spacing: 8px;

                Button {
                    text: "Push to Remote";
                    primary: true;
                    enabled: !root.syncing && AppState.sync-status.is-online;
                    clicked => {
                        root.syncing = true;
                        AppState.sync-to-remote();
                    }
                }

                Button {
                    text: "Pull from Remote";
                    enabled: !root.syncing && AppState.sync-status.is-online;
                    clicked => {
                        root.syncing = true;
                        AppState.sync-from-remote();
                    }
                }
            }
        }
    }

    GroupBox {
        title: "Database Settings";
        vertical-stretch: 0;

        VerticalBox {
            spacing: 8px;

            HorizontalBox {
                spacing: 8px;
                vertical-stretch: 0;

                VerticalBox {
                    horizontal-stretch: 1;
                    Text { text: "TursoDB URL"; }
                    turso-url := LineEdit {
                        horizontal-stretch: 1;
                        placeholder-text: "libsql://your-db.turso.io";
                    }
                }
            }

            HorizontalBox {
                spacing: 8px;
                vertical-stretch: 0;

                VerticalBox {
                    horizontal-stretch: 1;
                    Text { text: "Auth Token"; }
                    turso-token := LineEdit {
                        horizontal-stretch: 1;
                        placeholder-text: "Token";
                        input-type: password;
                    }
                }
            }

            HorizontalBox {
                spacing: 16px;
                vertical-stretch: 0;

                auto-sync-switch := Switch {
                    text: "Auto-sync enabled";
                    checked: false;
                }

                VerticalBox {
                    horizontal-stretch: 0;
                    Text { text: "Interval (seconds)"; }
                    sync-interval := SpinBox {
                        horizontal-stretch: 0;
                        value: 60;
                        minimum: 10;
                        maximum: 3600;
                    }
                }

                Rectangle { horizontal-stretch: 1; }
            }

            HorizontalBox {
                alignment: end;
                spacing: 8px;

                Button {
                    text: "Save Settings";
                    primary: true;
                    clicked => {
                        AppState.configure-sync(
                            turso-url.text,
                            turso-token.text,
                            auto-sync-switch.checked,
                            sync-interval.value
                        );
                    }
                }
            }
        }
    }

    GroupBox {
        title: "Offline Mode";
        vertical-stretch: 1;

        VerticalBox {
            Text {
                text: "When offline, all changes are stored locally and will be synchronized when connectivity is restored. TursoDB with LibSQL provides automatic conflict resolution for concurrent edits.";
                wrap: word-wrap;
                color: Palette.foreground.transparentize(0.3);
            }
        }
    }
}
